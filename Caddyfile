# Automatic HTTPS for RO. Nation LIVE.
#
# Caddy obtains and renews Let's Encrypt certificates by itself - there is no
# certbot, no cron job, and no renewal hook to maintain. It also redirects all
# HTTP traffic to HTTPS automatically.
#
# Certificates are stored in the `caddy-data` Docker volume, so they survive
# restarts and redeploys. Don't delete that volume casually: re-issuing counts
# against Let's Encrypt's rate limits (5 certs per domain per week).
#
# For this to work: ports 80 and 443 must be open on the server, and both names
# below must already resolve to it.
#
# ---- ADDING A HOST HERE? YOU MUST RECREATE THE CADDY CONTAINER. -------------
#
#   docker compose up -d --force-recreate caddy
#
# Not `restart`. Not `caddy reload`. RECREATE. Here is why, because it has already
# cost an outage once and the symptom points nowhere near the cause.
#
# This file is BIND-MOUNTED into the container as a single file
# (./Caddyfile:/etc/caddy/Caddyfile). Docker binds a single file by INODE, not by
# path. `git pull` does not edit a file in place - it writes a new one and renames
# it over the top, which produces a NEW INODE. The running container stays bound to
# the old, now-orphaned inode and can never see the new content, however many times
# you reload it.
#
# So all of these lie to you:
#
#   git pull                     the file on the host is correct
#   docker compose up -d         compose sees no change to the SERVICE definition
#                                (image, env, ports, volume list) - a file's contents
#                                are not part of that - so it leaves caddy alone
#   caddy reload                 succeeds, and cheerfully re-reads the OLD file that
#                                is still inside the container
#
# The proof, if you are ever here again:
#
#   grep -c MERCH_HOST Caddyfile                                        # -> 1
#   docker compose exec -T caddy grep -c MERCH_HOST /etc/caddy/Caddyfile # -> 0
#
# And the failure is NOT the 404 you would go looking for. Caddy has no certificate
# for the new name, so it ABORTS THE TLS HANDSHAKE: the browser says
# ERR_SSL_PROTOCOL_ERROR and `openssl s_client` says "no peer certificate available".
# Port 80 still answers and still 308s to HTTPS - it does that for ANY host, even one
# Caddy has never heard of - which makes it look like the config took. It did not.
{
	# Let's Encrypt emails this address before a cert expires. Renewal is
	# automatic either way - set ACME_EMAIL in .env to get the warnings.
	email {$ACME_EMAIL:admin@ronation.live}
}

# authorise.ronation.live is the sign-in host: it runs the ONE Roblox OAuth round
# trip and hands every other host a ticket (src/lib/sso.ts). It must be on this
# line and it must resolve, or nobody can sign in to anything. It is also the only
# redirect_uri Roblox knows about - so adding a NEW subdomain from here on needs a
# DNS record, a name on this line, and an entry in the allowlist in lib/sso.ts,
# and nothing whatsoever in the Roblox OAuth app.
#
# Adding a partner host: append it to the site address line below - but only
# once its DNS record already resolves to this server. Caddy asks Let's Encrypt
# for a certificate the moment you reload it, and a failed issuance still counts
# against the 5-per-domain-per-week limit.
#
# The shop answers on TWO names, and this is the one place that is not obvious:
#   merch.ronation.live   serves it.
#   shop.ronation.live    301s to merch, and serves nothing else, ever.
# Both need a DNS record and both need a certificate - a redirect still has to be
# spoken over HTTPS, so a `shop` host that resolves but is absent from this line
# fails with a TLS error rather than forwarding. The redirect itself is the app's
# (src/middleware.ts), not Caddy's, so there is one place that decision lives.
#
# Partner hosts live at the end of the line, one per partner:
#   sleeptokenro.ronation.live   → Sleep Token   (registry slug "sleeptokenro")
#
# The slug in lib/partners/registry.ts and the first label here MUST match - the
# app resolves the brand from the Host header alone, so a name that is live in
# DNS but absent from the registry serves RNL's site on the partner's domain,
# and a slug in the registry with no host here is simply unreachable.
{$SITE_HOST:ronation.live}, {$PORTAL_HOST:portal.ronation.live}, {$SURVEY_HOST:survey.ronation.live}, {$AUTHORISE_HOST:authorise.ronation.live}, {$MERCH_HOST:merch.ronation.live}, {$SHOP_HOST:shop.ronation.live}, {$STRO_HOST:sleeptokenro.ronation.live} {
	encode zstd gzip

	# These are set by the app's middleware, from the Host header, and read by the
	# root layout to decide which brand a page renders in. A client must never be
	# able to supply its own - strip them on the way in. The middleware also
	# overwrites both unconditionally; this is the second lock on the same door.
	request_header -X-Ron-Brand
	request_header -X-Ron-Area

	# Security headers, on every response from every host on the line above. All of
	# those hostnames are RNL's, so includeSubDomains on HSTS is safe.
	#
	#   HSTS             once a browser has seen this it refuses plain HTTP to the
	#                    whole domain for a year - no downgrade, no sslstrip.
	#   X-Frame-Options  the site is never meant to be framed; DENY stops clickjacking.
	#   Referrer-Policy  full path same-site, bare origin cross-site.
	#   nosniff          a response typed text/html is never re-guessed as script.
	#
	# The CSP carries frame-ancestors 'none' (the anti-framing lock) plus object-src
	# and base-uri 'none' - all safe to ENFORCE, none able to block a resource the app
	# legitimately loads. The /uploads handler below sets its own stricter CSP and wins
	# for those responses.
	#
	# Embedded PDFs do NOT need any of this relaxed: the docs and press viewers fetch
	# the bytes and frame a blob URL (components/pdf-embed.tsx), which has no headers
	# for a browser to refuse - so the whole site stays X-Frame-Options: DENY.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		# Rollout probe for a real script policy. Report-Only NEVER blocks - the browser
		# just logs what a strict `script-src 'self'` would break (Next 14 injects an
		# inline hydration bootstrap, so a full enforce needs a per-request nonce via
		# middleware first). Ship this to measure the gap, then promote to the enforcing
		# header above once the inline scripts carry a nonce. No report-uri set, so
		# violations stay in the console rather than being POSTed anywhere.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}

	# Uploaded images, served straight off the shared volume - they never touch
	# Next. This block must come BEFORE the reverse_proxy below; handle_path strips
	# the /uploads prefix, so /uploads/rnl/x.png reads /srv/uploads/rnl/x.png.
	#
	# The two headers are load-bearing, not hygiene. Everything under here was
	# uploaded by a human - RNL staff or a partner's manager - and SVG is an
	# accepted image type that can carry <script>. An <img src> never runs it, but
	# a browser NAVIGATED to the file would, on RNL's own origin, with RNL's
	# cookies. `sandbox` drops the document into an opaque origin so that script
	# can reach nothing; `nosniff` stops the browser second-guessing the type and
	# treating an image as HTML in the first place.
	handle_path /uploads/* {
		root * /srv/uploads
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# One upstream serves every name: the app reads the Host header to decide
	# whether you get the public site, the SHASHA portal, a survey or a partner's
	# site, and Caddy passes the original Host through untouched. `web` is the
	# service name on the Docker network - not localhost, which inside this
	# container would be Caddy.
	reverse_proxy web:3000 {
		# Pin the forwarded host to the real connection host. The app derives its
		# origin - OAuth redirect_uri, ticket audience, post-login redirect target and
		# QR ticket URLs - from X-Forwarded-Host (src/lib/origin.ts). Caddy overwrites
		# it by default, but pin it explicitly so a future proxy edit can't silently
		# start trusting a client-supplied value (a post-login open-redirect / audience
		# -spoof vector). This gets the same treatment X-Ron-Brand/X-Ron-Area already do.
		header_up X-Forwarded-Host {host}
	}

	log {
		output stdout
	}
}
