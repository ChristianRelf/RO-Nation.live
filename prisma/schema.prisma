// RO. Nation LIVE - data model
// Postgres via Prisma. Run `prisma db push` to sync, `prisma generate` for the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// People who sign in with Roblox to reserve tickets.
// ------------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  robloxId    String   @unique
  username    String
  displayName String
  avatarUrl   String?
  profileUrl  String?
  createdAt   DateTime @default(now())

  // ---- The Roblox OAuth grant -------------------------------------------
  //
  // Ordinary sign-in asks for `openid profile` and NOTHING else, so somebody who
  // only ever takes free tickets is never shown a permission prompt they did not
  // need. The moment they reach a PAID checkout on a game-pass tier we ask again -
  // for `user.inventory-item:read offline_access` - and THAT grant lands here.
  // That is what "incremental consent" means, and it is why these are nullable:
  // most rows will never have them.
  //
  // It lives on the USER rather than in the session cookie, and that is what makes
  // it work across hosts. Only the CONSENT has to happen on authorise.ronation.live
  // (the one registered redirect - see lib/sso.ts); the ownership check itself is a
  // server-side read of this row, and any host can do it.
  //
  // NOT ENCRYPTED, deliberately, and the scope list is the entire reason: this grant
  // can read exactly one thing - whether they own a game pass. It cannot spend a
  // Robux, change an avatar or post anything. If the scope set ever grows past
  // read-only inventory, encrypt these two columns BEFORE it does.
  //
  // Roblox refresh tokens ROTATE: spending one invalidates it and hands back a new
  // one. So refreshing is a COMPARE-AND-SWAP, never a plain update - two tabs
  // polling a checkout at once will both read the same expired token and both try
  // to spend it, and the loser's response would otherwise overwrite the winner's
  // and permanently break the grant. See accessTokenFor() in lib/roblox-tokens.ts.
  robloxAccessToken  String?   @db.Text
  robloxRefreshToken String?   @db.Text
  robloxTokenExpires DateTime?

  /// The scopes the stored grant actually carries. Read BEFORE we try to use it: a
  /// row written before any of this existed holds tokens for `openid profile` only,
  /// and asking Roblox about an inventory with those is a 401, not an answer.
  robloxScopes String[] @default([])

  tickets         Ticket[]
  applications    Application[]
  surveyResponses SurveyResponse[]
  surveyUploads   SurveyUpload[]
  enquiries       Enquiry[]

  /// Holds this person is PAYING for.
  purchaseIntents PurchaseIntent[] @relation("IntentPayer")

  /// Holds whose TICKET is destined for this person. The same rows as above for an
  /// ordinary purchase; different ones when somebody is buying for a friend.
  purchaseIntentsFor PurchaseIntent[] @relation("IntentBeneficiary")

  /// This account's Discord link and its live rotating link code, if any. Both are
  /// 1:1 - one Roblox account, one Discord - and cascade away with the user.
  discordLink DiscordLink?
  linkCode    LinkCode?

  /// This member's watchlist and the change-notices addressed to them. Both are
  /// user-owned and cascade away with the account.
  eventFollows  EventFollow[]
  notifications MemberNotification[]

  /// Sold-out shows this member is queued for. Cascades away with the account.
  waitlists Waitlist[]

  @@map("users")
}

// ------------------------------------------------------------------
// Linking a Roblox account to Discord.
//
// A signed-in member opens /account/link and is shown a 6-digit code that rotates
// every 20 seconds (LinkCode). They read it to a Discord bot, which calls
// POST /api/v1/discord/link with the code and the Discord user id; we look the code
// up, and if it is live we write the DiscordLink and burn the code.
//
// The code is the whole secret, and six digits is not much - so its safety is not the
// code, it is everything around it: the code is single-use, one-per-account and dies
// in 20 seconds, AND the redeem endpoint is key-gated (scope DISCORD_LINK) and rate
// limited per Discord id. Guessing a live code therefore costs a bot key and buys only
// a handful of tries against a target that is valid for 20 seconds. See
// lib/discord-link.ts.
// ------------------------------------------------------------------
model DiscordLink {
  id String @id @default(cuid())

  /// The Roblox account. One link per account.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// The Discord user. Unique too, so one Discord account cannot be claimed by two
  /// Roblox accounts - a would-be impersonator who guessed a code still cannot attach
  /// a Discord that is already attached elsewhere.
  discordId String @unique

  /// Display only, for the portal and the bot's convenience. Never identity -
  /// discordId is the key.
  discordUsername String?

  linkedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discord_links")
}

model LinkCode {
  id String @id @default(cuid())

  /// The six digits the page shows and the bot redeems. Unique across all live codes
  /// so a redeem resolves to exactly one account; indexed because that lookup is the
  /// hot path.
  code String @unique

  /// One live code per account. Rotating REPLACES this row (upsert on userId) rather
  /// than piling new codes up, so an account never has two valid codes at once.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// Short - 20 seconds. Past it the code is refused, and the daily cull
  /// (scripts/cull.ts) deletes it.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("link_codes")
}

// ------------------------------------------------------------------
// Events (shows, showcases, tournaments, meet-ups...).
// ------------------------------------------------------------------
enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// How much of the room a buyer gets to choose.
//
// NONE is what every event that exists today is, and the default, so adding this
// column changed nothing about any of them. The seat picker is skipped outright
// when it is NONE - see app/events/[slug]/seats/page.tsx - which is what lets
// seating ship without touching a single existing show.
enum SeatMode {
  /// No map. Every ticket is general admission, and that is the whole of it.
  NONE

  /// Buy an AREA: a standing pit, a gate, a tier of the balcony. There is no seat -
  /// you buy the section, and the section has a cap. Festivals.
  SECTION

  /// Buy a SEAT. Row K, seat 12. Stadiums.
  SEAT
}

model Event {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  tagline      String?
  description  String    @db.Text
  category     String    @default("Live Show")
  venue        String? // in-experience location / stage name
  placeUrl     String? // Roblox experience link
  thumbnailUrl String?
  startsAt     DateTime
  endsAt       DateTime?
  doorsAt      DateTime?
  capacity     Int       @default(0) // 0 = unlimited

  /// This show's ticket terms, ONE CLAUSE PER ELEMENT.
  ///
  /// EMPTY means "use the issuer's standard terms" (lib/tickets/terms.ts), which is
  /// what every show that exists today does - so this ships with no backfill and
  /// changes nothing until somebody types into the box.
  ///
  /// Not indexed, and deliberately: it is only ever read alongside the event row
  /// that owns it, so there is nothing to look it up BY. That also keeps it clear of
  /// the `prisma db push` trap documented on Ticket.seatKey - the safest index is
  /// the one nobody was tempted to add.
  ticketTerms String[] @default([])

  status   EventStatus @default(DRAFT)
  featured Boolean     @default(false)

  /// Presale: PUBLISHED and fully VISIBLE, but tickets are not on sale yet.
  ///
  /// A "coming soon" state that sits on top of PUBLISHED rather than being a fourth
  /// EventStatus - so every listing, the event page, the SEO and the sitemap keep
  /// treating it as live (which it is, to a browser), and the ONE thing it changes is
  /// that the buy rails refuse it. issueTicket returns `not_on_sale` for reserve /
  /// purchase / game_pass while this is true (a gift/comp still works, so organisers
  /// can seed VIPs before doors open), and the ticket buttons render "Tickets
  /// unavailable". Default false: every existing show is on sale exactly as before.
  presale Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the "doors soon" reminder was fanned out to this show's holders.
  ///
  /// The idempotency key for the reminder sweep (scripts/remind.ts): the sweep
  /// CLAIMS a show by setting this from null in one guarded update, and only the
  /// claimer fans the notices out - so two sweeps racing, or one run twice, send
  /// exactly one reminder per show. Null = not yet reminded, which every show is
  /// until it falls inside the window. Nullable and defaulted-by-absence, so
  /// `prisma db push` adds it to existing shows with nothing to backfill.
  reminderSentAt DateTime?

  /// The Roblox place id, as a STRING (Roblox ids passed 2^31 long ago - same
  /// reasoning as MerchProduct.assetId).
  ///
  /// `placeUrl` above is what a HUMAN clicks. This is what a deep link is BUILT
  /// from - roblox.com/games/start?placeId=<this>&launchData=<intent token> - and
  /// they are deliberately two columns rather than one parsed at use time, because
  /// scraping an id back out of a URL works right up until somebody pastes a link
  /// with a tracking query string on the end of it.
  placeId String?

  seatMode SeatMode @default(NONE)

  /// This event's OWN copy of a layout, cloned from a template when the event was
  /// created. SetNull, not Cascade: deleting a map must never delete a show.
  ///
  /// A CLONE, not a reference, and that is the whole design. A TEMPLATE is a library
  /// item ("The Vault - Main Stage") that gets drawn once and reused; an EVENT's map
  /// is a snapshot of one, with THIS event's tiers assigned to its sections. Point
  /// two live shows at one row and editing the template quietly re-seats a show that
  /// has already sold four hundred tickets. See VenueMap.kind.
  venueMap   VenueMap? @relation(fields: [venueMapId], references: [id], onDelete: SetNull)
  venueMapId String?

  // The partner whose show this is - a slug from lib/partners/registry.ts.
  // NULL means it is RO. Nation LIVE's own event. See the note on partnerId in
  // RosterEntry for why this is a plain column and not a foreign key.
  //
  // Every query that lists events MUST filter on this. An event with no filter
  // leaks a partner's draft line-up onto the RNL site, and - worse - puts RNL's
  // events on the partner's. lib/queries.ts takes the scope as a required
  // argument for exactly that reason: there is no "forgot to pass it" default.
  partnerId String?

  tickets      Ticket[]
  tiers        TicketTier[]
  testimonials Testimonial[]
  intents      PurchaseIntent[]

  /// Members watching this show, and the change-notices raised about it. A notice
  /// SetNulls its eventId (it must outlive a cancelled show); a follow cascades away.
  follows       EventFollow[]
  notifications MemberNotification[]

  /// The queue for a sold-out show. Cascades away with the event.
  waitlist Waitlist[]

  @@index([status, startsAt])
  @@index([partnerId, status, startsAt])
  @@index([venueMapId])
  @@map("events")
}

// ------------------------------------------------------------------
// A member's personal watchlist: shows they follow to keep an eye on.
//
// A WATCHLIST, not a notification subscription in its own right - but its followers
// ARE part of the audience for a change-notice (see MemberNotification), alongside
// anyone holding a ticket. User-scoped exactly like Ticket: read by userId, never
// listed by partner scope, so it carries no partnerId - the Event it points at
// already has one. Both sides cascade: unfollowing is deleting the row.
// ------------------------------------------------------------------
model EventFollow {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  createdAt DateTime @default(now())

  @@unique([userId, eventId]) // one follow per person per show; the idempotency key
  @@index([userId, createdAt])
  @@index([eventId])
  @@map("event_follows")
}

// ------------------------------------------------------------------
// The queue for a SOLD-OUT show. When a seat frees - somebody cancels or is voided
// - the oldest un-notified waiter is told (see lib/waitlist.ts, called from the two
// seat-freeing writers in issue.ts and actions/tickets.ts).
//
// A NOTICE, not a hold: joining the queue reserves nothing, and the "a spot opened"
// notification is first-come-first-served, not a claim on the seat. Holding a seat
// for a waiter would need the intent machinery and a way to expire it; the honest
// smaller thing is to tell them quickly and let them race for it.
//
// User-scoped like EventFollow, and no partnerId for the same reason: the Event it
// points at already carries one. `notifiedAt` is the guard against telling the same
// waiter twice - the seat-free hook claims the oldest row WHERE notifiedAt IS NULL.
// ------------------------------------------------------------------
model Waitlist {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// The tier they are waiting on, if they said. Null = any / general admission.
  /// A snapshot of intent only; the notice does not reserve the tier, so a deleted
  /// tier here is harmless - it just means "they wanted a seat", which is still true.
  tierId String?

  createdAt  DateTime  @default(now())
  /// When "a spot opened" was sent. NULL = still waiting, and it is what the
  /// seat-free hook claims on so a waiter is never told twice.
  notifiedAt DateTime?

  @@unique([userId, eventId]) // one place in the queue per person per show
  @@index([eventId, notifiedAt, createdAt]) // "oldest un-notified waiter for this show"
  @@map("waitlists")
}

// ------------------------------------------------------------------
// A change-notice TO one member: "the show you hold a ticket to was rescheduled".
//
// Fan-out on write - one row per affected member per change. Each row genuinely
// means "this person needs to see this", so unlike an empty seat row it earns its
// keep. The display text is FROZEN at write (title/body/url), for the same reason
// Ticket.tierName is: the event it refers to may be edited again, or deleted, and
// the notice must still read correctly. That is also why eventId is SetNull and
// nullable - a "this show was cancelled" notice has to survive the show.
//
// `seenAt` null means unseen; that is what pops the modal on the next page load and
// what the account hub counts. There is no delivery beyond the site itself: no
// member email exists, and notify() reaches a STAFF channel, never a member.
// ------------------------------------------------------------------
model MemberNotification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  kind  MemberNotificationKind
  title String
  body  String?                @db.Text
  url   String?

  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, seenAt, createdAt])
  @@map("member_notifications")
}

enum MemberNotificationKind {
  EVENT_RESCHEDULED
  EVENT_VENUE
  EVENT_CANCELLED
  EVENT_UPDATED

  // A "doors soon" nudge, raised by the reminder sweep (scripts/remind.ts) for
  // everyone holding a ticket to a show inside the reminder window. Unlike the four
  // above it is not triggered by an edit - nothing CHANGED - so it is its own kind,
  // and it goes to holders only, not followers: a reminder is for people who are
  // coming, not people still deciding. See lib/reminders.ts.
  EVENT_REMINDER

  // "A spot opened on the show you were waiting for." Raised when a seat frees on a
  // sold-out show, to the oldest un-notified waiter. See lib/waitlist.ts.
  WAITLIST_OFFER

  // "How was the show?" - a post-show survey invite, sent by an organiser to the
  // people who actually CHECKED IN (not merely reserved). See actions/feedback.ts.
  SURVEY_INVITE

  // ---- About THEIR ticket, not about the show -----------------------------
  //
  // The four above are one broadcast to everybody holding or following a show.
  // These two are addressed to ONE person, because somebody edited their row on
  // the company tickets page - and that difference is why they are separate kinds
  // rather than a fifth EVENT_UPDATED.
  //
  // The split between them is not cosmetic either: it is the only thing that tells
  // the notifier which dialog to open. TICKET_UPGRADED gets the celebration; every
  // other change to a ticket gets the ordinary notice. See lib/member-notify.ts
  // (diffTicketChange decides which) and components/notifications/.
  TICKET_UPDATED
  TICKET_UPGRADED
}

// ------------------------------------------------------------------
// What you can actually get for an event: General Admission, VIP, and so on.
//
// An event with NO tiers is not broken - it is read as a single free general
// admission, which is what every event was before this table existed. See
// `effectiveTiers` in lib/tickets/pricing.ts: that fallback is what let this
// ship without backfilling a tier row onto every past event.
//
// Prices are in Robux, and ONLY in Robux. There is no second currency and no
// `currency` column to get wrong - a Roblox event sells to Roblox players. A
// tier priced above zero cannot actually be issued yet: paid ticketing is behind
// the kill switch in lib/tickets/pricing.ts, and both the checkout page and the
// reserve action refuse independently while it is off.
// ------------------------------------------------------------------
model TicketTier {
  id          String   @id @default(cuid())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  name        String // "General Admission", "VIP - Front Barrier"
  description String?
  /// One perk per line, listed on the tier card at checkout.
  perks       String[] @default([])

  /// 0 = free. Anything above 0 needs Robux payments switched on to be sold.
  priceRobux Int @default(0)

  /// A cap for THIS tier. 0 = uncapped, though the event's own capacity still
  /// applies on top - a tier can never oversell the room.
  capacity Int @default(0)

  // ---- What you actually BUY, on each of the two rails --------------------
  //
  // Two ids, because THE SURFACE PICKS THE RAIL, NOT THE TIER. A buyer on the web
  // buys the game PASS; a buyer standing at a booth inside the experience buys the
  // developer PRODUCT. One tier may offer either, or both, and a priced tier that
  // offers NEITHER cannot be sold anywhere - the tier editor says so loudly.

  /// The Roblox GAME PASS that buys this tier on the WEB.
  ///
  /// This is the rail that can be VERIFIED. A pass is bought on roblox.com, in a
  /// browser, and afterwards we can ask Roblox's Open Cloud whether they own it -
  /// with the buyer's own OAuth grant. No game server, and nobody's word for it.
  /// It is the answer to the note on TicketPurchase below.
  ///
  /// UNIQUE, and that constraint is doing real work. A pass is owned FOREVER: once
  /// you have it, Roblox will never sell it to you again, and our ownership check
  /// will answer "yes, they paid" for the rest of time. So a pass may back exactly
  /// ONE (event, tier), and next month's show needs a NEW pass.
  ///
  /// Without this: paste last month's VIP pass onto this month's VIP tier, and every
  /// one of last month's buyers walks into this month's show for free - verified,
  /// waved through by our own check, with a payment record we wrote ourselves. That
  /// is not a hypothetical failure mode. It is the FIRST thing a copy-paste produces.
  ///
  /// NULLs are distinct in Postgres, so every free tier holds NULL here and they do
  /// not collide with each other. A plain unique index, which `prisma db push`
  /// preserves - unlike the partial ones it silently drops (see Career.slug).
  gamePassId String? @unique

  /// The Roblox DEVELOPER PRODUCT that buys this tier INSIDE the experience.
  ///
  /// This is what a walk-up ticket booth prompts: the game reads this off
  /// GET /api/v1/events/<id>, calls MarketplaceService:PromptProductPurchase, and
  /// its ProcessReceipt handler calls POST /api/v1/tickets/purchase. It is the rail
  /// that CANNOT be verified (read TicketPurchase), and the rail that can GIFT -
  /// a product is a payment, not an item, so it can grant a ticket to anybody.
  ///
  /// NOT unique, and the difference from gamePassId above is the whole point: a
  /// product is a PAYMENT, not a possession. Buying one twice is two payments and
  /// Roblox is happy to take both, so the same product may legitimately back the
  /// same tier across a recurring show without anybody getting in free.
  devProductId String?

  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  intents PurchaseIntent[]

  @@index([eventId, sortOrder])
  @@map("ticket_tiers")
}

// ------------------------------------------------------------------
// A reserved ticket = one User for one Event. Verified in-game via API.
// ------------------------------------------------------------------
enum TicketStatus {
  RESERVED
  CHECKED_IN
  CANCELLED
}

model Ticket {
  id              String       @id @default(cuid())
  code            String       @unique // human-readable, e.g. RN-7F3A9C
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  status          TicketStatus @default(RESERVED)
  createdAt       DateTime     @default(now())
  checkedInAt     DateTime?
  termsAcceptedAt DateTime? // when the holder accepted the ticket T&Cs at checkout

  /// WHAT THEY ACTUALLY AGREED TO. Frozen at issue, one clause per element.
  ///
  /// Same reasoning as tierName and seatLabel below, and the same reason
  /// SurveyResponse keeps a denormalised username: the organiser may rewrite these
  /// terms tomorrow, and what this person accepted is what their ticket says,
  /// forever. termsAcceptedAt has always recorded WHEN they agreed; without this it
  /// recorded agreement to a text nobody could reconstruct afterwards, which is the
  /// half of the record that actually matters if it is ever disputed.
  ///
  /// EMPTY on every ticket issued before this column existed, and the UI reads that
  /// as "not recorded" and says nothing - which is the honest answer, because we
  /// genuinely did not record it. No backfill: inventing a snapshot from today's
  /// terms would be worse than admitting the gap.
  termsSnapshot String[]  @default([])
  activatedAt   DateTime? // when the holder "activated" the ticket (reveals QR)

  // Which tier they hold. SetNull, not Cascade: deleting a tier must not delete
  // the tickets people are already holding to a show that is still happening.
  // They keep their seat - the snapshot below is what still names it.
  tier   TicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  tierId String?

  // Frozen at issue, and deliberately duplicated from the tier.
  //
  // Renaming "VIP" to "VIP - Front Barrier", re-pricing it, or deleting it
  // outright must not rewrite a ticket somebody already holds: what they bought
  // is what their ticket says, forever. Same reasoning as the denormalised
  // username on SurveyResponse. NULL tierName = the implicit free admission.
  tierName   String?
  priceRobux Int     @default(0)

  // ---- Who gave it to them, if it was not simply taken ------------------
  //
  // NULL for the ordinary case: the holder reserved it themselves on the web.
  // Set when a ticket was issued to somebody BY somebody - a gift from another
  // player, a comp from the crew, an issue from a game server. Display and
  // audit only; it grants nothing and is never read at the door.
  issuedByRobloxId String?
  issuedByName     String?

  // ---- Revocation --------------------------------------------------------
  //
  // The difference between VOIDING a ticket and REVOKING one, and it is the only
  // thing that records it.
  //
  // Voiding sets status = CANCELLED and stops here. It is the undo: a ticket
  // issued to the wrong person, a duplicate, a change of plan. The holder is free
  // to reserve again, exactly as if they had cancelled it themselves.
  //
  // Revoking sets status = CANCELLED *and* stamps this. It is the ban: the reason
  // they may not have a ticket is the person, not the ticket. Because a Ticket row
  // is unique on (eventId, userId) and cancellation keeps the row, the stamp
  // survives - and the reserve path refuses to re-issue over it. Un-revoking is
  // clearing this column, which is why it is a timestamp and not a boolean.
  //
  // It bans them from THIS SHOW, not from the org. A standing ban is the
  // blacklist (RosterEntry), which is a different question with a different
  // answer.
  revokedAt     DateTime?
  revokedReason String?
  revokedByName String?

  // ---- Where they are standing or sitting ---------------------------------

  /// WHICH SEAT. "A1-K12" = section A1, row K, seat 12. NULL on an unseated show,
  /// which is every show that exists today.
  ///
  /// Seats are DERIVED, never stored. There is no Seat table and there must not be:
  /// a 2,000-seat venue would mean 2,000 rows per show whose entire job is to say
  /// "nobody is sitting here". A section carries a ROW SPEC, and lib/venue/seats.ts
  /// turns that spec into seat keys. THIS column is the only place a seat exists in
  /// the database - and it exists precisely because somebody is in it.
  ///
  /// ---- Why this is a PLAIN unique index, and what that costs ---------------
  ///
  /// @@unique([eventId, seatKey]) below is the one rule about seating that the
  /// DATABASE enforces, and no code path - present or future, careful or not - can
  /// argue with it. NULLs are distinct in Postgres, so every general-admission
  /// ticket holds NULL here and unlimited GA coexists with assigned seating on the
  /// same show.
  ///
  /// The tighter rule we actually want - unique among LIVE tickets - would be a
  /// PARTIAL index, and `prisma db push` runs on every boot and silently drops those
  /// (the same trap already documented on Career.slug). An enforcement that quietly
  /// disappears on a Tuesday is worse than one that is written down.
  ///
  /// So this index binds CANCELLED rows too. Which means:
  ///
  ///     CANCELLING A TICKET NULLS THIS COLUMN. That is what frees the seat.
  ///
  /// Both writers do it - voidTicket() in lib/tickets/issue.ts and cancelTicket() in
  /// app/actions/tickets.ts. Forget it in either one and that chair is unsellable for
  /// the life of the show, with nothing on any screen to say why: the constraint holds
  /// against a dead row, the seat renders taken, and nobody is sitting in it.
  seatKey String?

  /// WHICH SECTION. Set in SEAT mode (denormalised out of seatKey, so counting a
  /// section is one indexed read instead of a LIKE over every ticket) and in SECTION
  /// mode - where there is no seat at all, because you buy the pit, not a chair in it.
  ///
  /// Nulled alongside seatKey on cancellation, for exactly the same reason.
  sectionKey String?

  /// "Section A1 · Row K · Seat 12". FROZEN AT ISSUE, exactly like tierName above,
  /// and for the identical reason: the map gets redrawn, the section gets renamed,
  /// the seat gets released by a cancellation - and what their ticket SAYS is what
  /// they bought, forever.
  ///
  /// This is also what survives seatKey being nulled. A cancelled ticket still knows
  /// where its holder would have been sitting; it just no longer holds the chair.
  seatLabel String?

  /// Every Robux payment made against this ticket. A LIST, not one: a holder who
  /// already has general admission and then buys VIP inside the experience is
  /// upgrading the one ticket they are allowed to hold for this event, and that
  /// is a second payment against the same row.
  purchases TicketPurchase[]

  @@unique([eventId, userId]) // one ticket per person per event
  @@unique([eventId, seatKey]) // and one person per seat. See the note above.
  @@index([eventId])
  @@index([eventId, sectionKey])
  /// THE WALLET'S INDEX, and it was missing.
  ///
  /// Every index above leads with eventId, which is the door's question ("who is
  /// coming to this show"). Nothing served the HOLDER's question ("what am I
  /// holding") - and @@unique([eventId, userId]) cannot: a composite index is only
  /// reachable from its leading column, so a userId-only lookup walks past it and
  /// scans. That is what /tickets, the account hub and lib/account.ts all do.
  ///
  /// checkedInAt rides along because attendance is counted by it and by nothing else
  /// - `status` can be flipped back to RESERVED by staff, the timestamp cannot - so
  /// "how many shows has this person been to" is answerable out of the index alone.
  ///
  /// A PLAIN index, which is the only kind worth writing here: `prisma db push` runs
  /// on every boot and silently drops partial ones. See the note on seatKey above.
  @@index([userId, checkedInAt])
  @@map("tickets")
}

// ------------------------------------------------------------------
// A Robux payment, as reported by a Roblox game server.
//
// This table exists because we CANNOT verify a Developer Product receipt. Roblox
// offers no server-to-server endpoint to ask "was purchase X really paid for?" -
// the only witness to a purchase is the ProcessReceipt handler running inside the
// experience, and it tells us. So the trust boundary is the API key: whoever holds
// a key with `tickets:purchase` can assert that somebody paid, and we believe them.
// That is worth saying out loud rather than burying, because it means a leaked
// purchase-scoped key can mint paid tickets for free.
//
// ---- All of which is true of ONE of the two rails --------------------------
//
// Everything above describes the DEVELOPER PRODUCT rail, and on that rail it is
// still exactly true.
//
// The GAME PASS rail does not have this problem, and it is why it exists. A pass is
// bought on roblox.com, in a browser - and afterwards we can ASK ROBLOX whether they
// own it, over Open Cloud, authorised by the buyer's own OAuth grant. Nobody's word
// for it, no game server in the loop, and no key that can assert a payment: a claim
// on that rail is checked, not believed. See lib/roblox-gamepass.ts.
//
// So the honest summary is not "we cannot verify payments". It is:
//
//   GAME_PASS    verified against Roblox. A leaked key mints nothing - the rail does
//                not go through this endpoint at all.
//
//   DEV_PRODUCT  believed. But NARROWED, once a PurchaseIntent is in play: a leaked
//                key can now only settle a hold that a real signed-in person actually
//                created, for the seat they actually picked, before it expires. That
//                is a much smaller hole than "mint any ticket for anyone" - and on a
//                seated show the intent is REQUIRED, so it is the only hole there is.
//
// Narrowed, not closed. Still give `tickets:purchase` only to a place you would trust
// with your own Robux, and still revoke it the moment a key leaks.
//
// What this table CAN do, and the reason it is a table rather than a column, is
// stop the same payment being honoured twice. `purchaseId` is Roblox's own
// PurchaseId - a GUID, unique per transaction - and it is the unique key here.
// ProcessReceipt is explicitly at-least-once: Roblox re-delivers a receipt until
// the game returns PurchaseGranted, and a game server that crashes mid-call will
// send it again. Without this, a re-delivery is a second ticket. With it, the
// insert loses on the unique constraint and we hand back the FIRST ticket, which
// is exactly what a retry should get.
// ------------------------------------------------------------------
model TicketPurchase {
  id String @id @default(cuid())

  /// Roblox's PurchaseId from the ProcessReceipt info. The idempotency key -
  /// see the note above. This unique constraint IS the double-charge guard.
  purchaseId String @unique

  /// The ticket the payment bought. Cascade: a deleted ticket has no payment to
  /// remember, and keeping the row would block the purchaseId forever.
  ///
  /// NOT unique - see Ticket.purchases. One ticket can be paid for twice, because
  /// upgrading a tier is a second payment against the same ticket, and a unique
  /// constraint here would reject the upgrade after the player had been charged.
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  /// What Roblox said it cost, as reported. Recorded, never trusted as authority -
  /// the ticket's own priceRobux is the tier's price, read from our database.
  robuxSpent Int @default(0)

  /// Which key asserted the payment. NOT an FK - a key may be deleted, and the
  /// payment record must outlive it. This is the audit trail for the trust boundary.
  apiKeyId String?

  /// The Roblox place / product the purchase happened in, if the game sent them.
  placeId   String?
  productId String?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_purchases")
}

// ------------------------------------------------------------------
// A venue, drawn.
//
// Stages, seated blocks, standing pits, gates. Geometry in a flat viewBox, plus one
// anchor that maps that viewBox onto real Roblox studs - so the same drawing renders
// as an SVG seat picker on the web AND as a 3D seat map inside the experience.
//
// ---- Templates and copies ------------------------------------------------
//
// A TEMPLATE is a library item: "The Vault - Main Stage", drawn once, reused for
// every show that happens there. An EVENT map is a SNAPSHOT of a template with one
// event's tiers assigned to its sections.
//
// The copy is the point. Pointing two live shows at one row would mean that tidying
// up a template on a Tuesday silently re-seats a show that has already sold four
// hundred tickets - and the people holding those tickets would find out at the door.
// So creating an event CLONES, and the two rows drift apart from that moment on.
// ------------------------------------------------------------------
enum VenueMapKind {
  /// A reusable library layout. Cloned onto events; never sells anything itself.
  TEMPLATE

  /// One event's own copy. Owned by that event, edited freely, dies with it.
  EVENT
}

model VenueMap {
  id String @id @default(cuid())

  /// A slug from lib/partners/registry.ts, or NULL for RNL's own. Same convention as
  /// Event.partnerId - and the same rule, which is not optional: every query that
  /// LISTS maps must filter on this, or one org's venues turn up in another's designer.
  partnerId String?

  /// "The Vault - Main Stage".
  name String
  kind VenueMapKind @default(TEMPLATE)

  /// The template this was cloned from. A plain column and deliberately NOT a foreign
  /// key: the template may be deleted, and an event's map has to outlive it. Display
  /// and provenance only - nothing reads it to make a decision.
  templateId String?

  /// THE LAYOUT. Shapes with stable keys, the viewBox, the world anchor, and the row
  /// spec on every seated section.
  ///
  /// Json because it is a tree of heterogeneous shapes of arbitrary length, which flat
  /// columns model badly and a shapes table models worse - a section's seats are a
  /// SPEC, not four hundred rows.
  ///
  /// Validated with zod on the way IN (lib/venue/schema.ts) and never trusted on the
  /// way out. Same contract as PartnerContent, and the same reason: this column is
  /// written from a browser.
  layout Json

  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedByName String?

  events Event[]

  @@index([partnerId, kind, name])
  @@map("venue_maps")
}

// ------------------------------------------------------------------
// The bridge between "I picked that seat" and "I paid for it".
//
// It exists because those two things are separated by a round trip through somebody
// else's website (a game pass page on roblox.com) or somebody else's game server (a
// ProcessReceipt handler) - and for the length of that trip, the seat has to belong
// to nobody else. A hold is the only honest way to sell a numbered seat. Without one,
// two people pay Robux for A1-K12 and exactly one of them gets it.
//
// ---- What it is NOT ------------------------------------------------------
//
// It is not a lock. The LOCK is the event row (SELECT … FOR UPDATE), which every
// reader and writer of a hold takes - so "is this seat held?" and "hold this seat"
// are one serialised step per event and cannot interleave.
//
// And it is not the last word either. The last word is Ticket's
// @@unique([eventId, seatKey]): if a hold is ever wrong, the ticket INSERT loses on a
// constraint rather than overselling a chair. A hold is an optimisation on the
// buyer's experience. The unique index is the truth.
// ------------------------------------------------------------------
enum PurchaseRail {
  /// Paid on roblox.com, on a game pass page, in a browser. VERIFIABLE: afterwards we
  /// ask Roblox's Open Cloud whether they own the pass, using their own OAuth grant.
  /// This is the rail that closes the trust hole described on TicketPurchase.
  GAME_PASS

  /// Paid INSIDE the experience, as a Developer Product, witnessed only by the game's
  /// ProcessReceipt handler. Still unverifiable - but an intent NARROWS it: a leaked
  /// TICKETS_PURCHASE key can now only settle a hold that a real signed-in person
  /// actually created, for the seat they actually picked.
  DEV_PRODUCT
}

enum IntentStatus {
  PENDING
  CONSUMED
  CANCELLED
}

model PurchaseIntent {
  id String @id @default(cuid())

  /// What travels. It goes in a game pass popup's return URL, and in `launchData` on a
  /// Roblox deep link - which the game reads back with player:GetJoinData().LaunchData.
  ///
  /// So it ends up in URLs, on Roblox's servers, and in some game's logs. It is worth
  /// nothing to a stranger, and three properties are why: it is BOUND TO A USER (issue.ts
  /// refuses to spend an intent for anybody but its beneficiary), it cannot be replayed
  /// (status), and it dies in ten minutes (expiresAt). The same three things that make an
  /// SsoTicket safe to put in a query string.
  token String @unique

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// SetNull, exactly like Ticket.tierId: deleting a tier must not delete the record of a
  /// hold somebody may already have PAID against. A claim on a null tier fails `badtier`,
  /// and the price snapshot below is what support reads to work out what to refund.
  tier   TicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  tierId String?

  /// WHO IS PAYING. The signed-in session that created the hold, or the player standing
  /// at the booth. The intent may be spent by nobody else, and that is the single thing
  /// that makes the token safe to hand to Roblox.
  user   User   @relation("IntentPayer", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// WHO GETS THE TICKET. Equal to userId for an ordinary purchase; different when
  /// somebody is buying for a friend.
  ///
  /// Two columns rather than one, because A GAME PASS CANNOT BE GIFTED. Roblox has no
  /// mechanism for it: the pass lands in the inventory of whoever paid, so our ownership
  /// check would be asking about the wrong person and would answer "no, they didn't pay"
  /// about somebody who did. So createPurchaseIntent() REFUSES a beneficiary who is not
  /// the payer on the GAME_PASS rail, and that one refusal is the entire rule. Paid
  /// gifting is a Developer Product, bought inside the experience.
  beneficiary       User   @relation("IntentBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  beneficiaryUserId String

  /// The seat being held. NULL on an unseated event - where the hold is only about the
  /// tier's cap, and is STILL worth taking: a paid tier's last ticket can sell out while
  /// the buyer is away on roblox.com, and they would come back having been charged.
  seatKey    String?
  sectionKey String?

  /// How this one is going to be paid for - or NULL, when it is not.
  ///
  /// Nullable because a FREE seated ticket still needs a hold. Picking seat A1-K12 and
  /// then walking to the checkout is a gap of a few seconds, and somebody else can take
  /// the chair inside it; the hold is what stops them, and it has nothing to do with
  /// money. Forcing a rail onto that row would mean writing down a payment method for a
  /// payment that is never going to happen, and something downstream would eventually
  /// believe it.
  ///
  /// So: NULL = nothing to pay. Which is also the honest answer.
  rail   PurchaseRail?
  status IntentStatus  @default(PENDING)

  /// SNAPSHOTS, frozen at hold. Same reasoning as Ticket.tierName: the tier can be
  /// re-priced, renamed or deleted while the buyer is standing on Roblox's website, and
  /// none of that changes what they were quoted or which pass we sent them to buy.
  ///
  /// `gamePassId` here is a RECORD, never the authority - issue.ts re-reads the pass id
  /// from the live tier row and refuses if the two disagree.
  priceRobux Int     @default(0)
  gamePassId String?

  /// Ten minutes. Past it the hold is ignored by every reader.
  ///
  /// An expired hold is NOT a refusal. A buyer who paid anyway - and they will, because
  /// the charge happened on a page we do not control - falls back to the best available
  /// seat in the same tier. It costs them the seat they chose, not the ticket they paid
  /// for. See the game_pass branch in lib/tickets/issue.ts.
  expiresAt DateTime

  /// Rate limit for the game-pass rail's polling, and it lives in the DATABASE rather
  /// than in a ref on the client so that hitting refresh cannot reset it. The checkout
  /// polls US every 2s; we ask ROBLOX at most once every 4s.
  checkedAt DateTime?

  consumedAt DateTime?

  /// What it became. NOT a relation - it is a receipt, and it has to survive the ticket
  /// being deleted.
  ticketId String?

  createdAt DateTime @default(now())

  @@index([eventId, status, expiresAt])
  @@index([eventId, seatKey, status])
  @@index([userId, status])
  @@map("purchase_intents")
}

// ------------------------------------------------------------------
// Careers / open roles in the group.
// ------------------------------------------------------------------
enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

model Career {
  id String @id @default(cuid())

  /// A slug from lib/partners/registry.ts, or NULL for RNL's own. Same convention
  /// as Event.partnerId - and the same rule: every query that LISTS careers must
  /// filter on this, or one org's openings appear on another's site.
  partnerId String?

  slug         String
  title        String
  department   String    @default("Events")
  commitment   String    @default("Volunteer") // Volunteer / Paid / Trial
  location     String    @default("Remote - Roblox")
  summary      String
  description  String    @db.Text
  requirements String    @db.Text // one requirement per line
  status       JobStatus @default(DRAFT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications Application[]

  /// Scoped, not global: /careers/event-host on RNL and on a partner's site are
  /// different pages, and neither should block the other from existing.
  ///
  /// CAVEAT, and it is a real one: Postgres treats NULLs as distinct, so this
  /// constraint does NOT stop two RNL rows (partnerId = NULL) sharing a slug - it
  /// only binds partner rows, where the column is a real value. RNL's uniqueness
  /// therefore rests on uniqueSlug() in lib/content.ts, which loops until it finds
  /// a free slug in the scope. A partial unique index (WHERE partnerId IS NULL)
  /// would close the gap properly, but the entrypoint runs `prisma db push` on
  /// every boot, and that makes the database match this schema exactly - it would
  /// drop a hand-made index silently, every deploy. An enforcement that quietly
  /// disappears is worse than one that is written down.
  @@unique([partnerId, slug])
  @@index([partnerId, status])
  @@map("careers")
}

// ------------------------------------------------------------------
// Blog posts. Written in /company by RNL staff, or in a partner's studio by
// their crew. Authorship is recorded from the writer's Roblox account.
// ------------------------------------------------------------------
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id String @id @default(cuid())

  /// A slug from lib/partners/registry.ts, or NULL for RNL's own.
  partnerId String?

  slug           String
  title          String
  excerpt        String?
  coverUrl       String?
  body           String     @db.Text
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime? // set the first time it goes PUBLISHED
  authorRobloxId String?
  authorName     String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  /// Scoped per partner, with the same NULL caveat as Career.slug above - read
  /// that note before relying on this to keep RNL's own slugs unique.
  @@unique([partnerId, slug])
  @@index([partnerId, status, publishedAt])
  @@map("posts")
}

// ------------------------------------------------------------------
// Surveys. Built in the Studio, answered at survey.ronation.live/<code>.
// Respondents sign in with Roblox - one response per account.
// ------------------------------------------------------------------
enum SurveyStatus {
  DRAFT // not reachable by anyone
  OPEN // accepting responses
  CLOSED // link still works, but says it's closed
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  CHOICE // pick exactly one of `options`
  CHECKBOXES // pick any number of `options`
  RATING // 1–5
  YES_NO
  FILE_UPLOAD // attach files - see SurveyUpload
}

model Survey {
  id             String       @id @default(cuid())
  code           String       @unique // XXXXX-XXXXXXX-XXX, the public URL
  title          String
  description    String?      @db.Text
  status         SurveyStatus @default(DRAFT)
  authorRobloxId String?
  authorName     String
  closesAt       DateTime? // optional deadline; past it, treated as CLOSED

  /// Off: one response per Roblox account, which is the default and what every
  /// survey did before this existed. On: the same person may answer as often as
  /// they like - for a recurring check-in, a bug report form, a suggestion box.
  ///
  /// Enforced by SurveyResponse.dedupeKey, not by reading this at insert time.
  multipleResponses Boolean @default(false)

  /// Whose survey this is - a slug from lib/partners/registry.ts, or NULL for RO.
  /// Nation LIVE's own (authored in /company). The last content model to grow this
  /// column; every listing query must filter on it, exactly as Event/Post/Career do.
  ///
  /// The PUBLIC responder (survey.ronation.live/<code>) is unaffected: a code is
  /// globally unique, so answering never needs the scope. Only AUTHORING is scoped -
  /// a partner builds and reads its own in the studio, RNL its own in /company - and
  /// the survey action reads this off the form's `scope` field, guarded per-scope.
  ///
  /// Nullable and defaulted-by-absence: `prisma db push` adds it to every existing
  /// survey as NULL (RNL's), which is exactly what they all are today. No backfill.
  partnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([status])
  @@index([partnerId, status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String       @id @default(cuid())
  survey   Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId String
  order    Int
  type     QuestionType
  prompt   String       @db.Text
  helpText String?
  required Boolean      @default(false)
  options  String[]     @default([]) // CHOICE / CHECKBOXES only

  // ---- FILE_UPLOAD only -------------------------------------------------
  //
  // The three limits the survey's author sets. All nullable/empty on every other
  // type, and all of them TIGHTEN what lib/uploads.ts already permits - none can
  // loosen it. A creator asking for 100 MB of .exe gets whatever the upload module
  // was going to allow anyway; these only ever narrow that.
  maxFiles  Int? // how many files may be attached, 1–10
  maxFileMb Int? // per-file cap in MB, on top of the module's own per-type cap
  /// Allowed content types, from SURVEY_FILE_TYPES. Empty means "all of them".
  /// These are sniffed mimes, never the browser's claim - see lib/uploads.ts.
  fileTypes String[] @default([])

  answers SurveyAnswer[]
  uploads SurveyUpload[]

  @@index([surveyId, order])
  @@map("survey_questions")
}

model SurveyResponse {
  id             String   @id @default(cuid())
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId       String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  robloxUsername String // denormalised so results survive a rename
  createdAt      DateTime @default(now())

  /// What makes "one response per account" a DATABASE fact rather than a hopeful
  /// check, while still letting a survey opt out of it.
  ///
  /// Empty string when the survey takes one response per account: every row for a
  /// given user then collides on the unique below, so two tabs submitting at once
  /// cannot both win - one gets P2002 and is turned away. That is the same
  /// guarantee @@unique([surveyId, userId]) used to give, and it is deliberately
  /// not softened into an application-level "does a response exist yet?", which
  /// two concurrent requests both answer "no".
  ///
  /// A fresh cuid() when the survey allows multiple responses: every row is then
  /// unique on its own and the constraint never fires.
  ///
  /// The default is "" ON PURPOSE. `prisma db push` backfills existing rows with
  /// it, so every survey written before this column existed keeps exactly the
  /// protection it had. A nullable column would have been the obvious shape and
  /// would have quietly broken that: Postgres treats NULLs as distinct, so the
  /// unique index would not have applied to the old rows at all.
  dedupeKey String @default("")

  answers SurveyAnswer[]
  uploads SurveyUpload[]

  @@unique([surveyId, userId, dedupeKey])
  @@index([surveyId])
  @@index([surveyId, userId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  value      String         @db.Text // text, "YES"/"NO", "1".."5", or the chosen option
  /// CHECKBOXES: the options picked. FILE_UPLOAD: the SurveyUpload ids attached -
  /// in both cases `value` is the same list rendered for a human, so anything that
  /// only wants to print an answer can keep reading `value` and ignore this.
  values     String[]       @default([])

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("survey_answers")
}

// ------------------------------------------------------------------
// A file attached to a FILE_UPLOAD answer.
//
// The bytes go to the PRIVATE volume, the one Caddy does not mount - a survey
// answer is somebody's CV or a photo of their setup, and "unguessable URL" is not
// an access control. The only reader is app/files/survey/[id], which checks for a
// company user on every request.
//
// The row is written when the file is uploaded, which is BEFORE the response
// exists: the respondent picks files, they go up out-of-band (a server action's
// body caps at 1 MB), and only the ids ride along with the submit. So responseId
// is nullable, and a null one means "uploaded, never submitted" - the tab was
// closed, the file was swapped for another. Those are orphans and scripts/cull.ts
// sweeps them, bytes included.
//
// Attaching is therefore a CLAIM: submit only accepts an upload that is this
// user's, for this question, and not yet spoken for (responseId null). Without
// that last condition a respondent could post someone else's id and read the file
// back through the results page.
// ------------------------------------------------------------------
model SurveyUpload {
  id String @id @default(cuid())

  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  /// Who uploaded it. Recorded at upload time, when there is no response to hang
  /// it off yet, and re-checked at submit - this is what stops one respondent
  /// claiming another's file.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Set when the response is submitted. Null means unclaimed - see above.
  response   SurveyResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId String?

  /// "<scope>/<uuid>.<ext>", relative to PRIVATE_UPLOAD_DIR. Ours, never the
  /// client's - the uploader's own filename is display-only and below.
  storagePath String
  mime        String // sniffed from the bytes
  size        Int
  filename    String // what they called it, for the results page
  createdAt   DateTime @default(now())

  @@index([questionId, userId, responseId])
  @@index([responseId])
  @@map("survey_uploads")
}

// ------------------------------------------------------------------
// Roster portals - VIP list & blacklist.
//
//   portal.ronation.live/shasha  → RNL's own lists      (partnerId "shasha")
//   portal.ronation.live/<slug>  → a partner's lists    (partnerId <slug>)
//
// Both lists hold the same shape, keyed on a Roblox player, so they share
// one model discriminated by `kind` - and every partner's copy of both lists
// shares it too, discriminated by `partnerId`.
// ------------------------------------------------------------------
enum RosterKind {
  VIP
  BLACKLIST
}

model RosterEntry {
  id String @id @default(cuid())

  // Which organisation's list this row belongs to.
  //
  // This is a plain scope column, NOT a foreign key, because there is no Partner
  // table to point at: the partner list lives in code (lib/partners/registry.ts)
  // so that middleware - which runs on the edge, where Prisma cannot - can
  // resolve a brand from the Host header alone. The registry is the partner
  // table; this column references a slug in it.
  //
  // "shasha" is RNL's own list, and it is safe as a sentinel precisely because
  // the registry's RESERVED set already forbids any partner from taking that
  // slug. It is also the default, which is what backfills the existing SHASHA
  // rows on the migration that added this column - they predate partners, and
  // they are all SHASHA's.
  partnerId String @default("shasha")

  kind           RosterKind
  robloxId       String // canonical Roblox user id - resolved server-side
  robloxUsername String
  displayName    String
  avatarUrl      String?
  tags           String[]   @default([]) // free-form roles, e.g. "vip+", "artist"
  reason         String     @db.Text
  // The manager who added them. A Roblox user id since the portal moved to
  // Roblox sign-in; rows written before that hold a Discord id. Never joined on
  // - it is a display/audit trail - so the mixed history is harmless, but don't
  // assume you can resolve every one of these against Roblox.
  addedById      String
  addedByName    String
  updatedById    String?
  updatedByName  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // One entry per person per list PER ORG. Scoping the unique key is what lets
  // two partners hold the same player on their blacklists independently - and
  // it is a NOT NULL column, so Postgres treats the tuples as comparable. (A
  // nullable partnerId would have silently allowed duplicate RNL rows, since
  // NULLs are never equal to each other in a unique index.)
  @@unique([partnerId, kind, robloxId])
  @@index([partnerId, kind, createdAt])
  @@index([robloxUsername])
  @@map("roster_entries")
}

// Append-only history of every write to the lists, so management can see
// who added or removed whom, and why.
enum RosterAction {
  ADDED
  UPDATED
  REMOVED
}

model RosterAudit {
  id             String       @id @default(cuid())
  /// The org whose history this is - see RosterEntry.partnerId.
  partnerId      String       @default("shasha")
  action         RosterAction
  kind           RosterKind
  robloxId       String
  robloxUsername String
  actorId        String // Roblox user id (Discord id on rows written before the portal moved to Roblox sign-in)
  actorName      String
  summary        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([partnerId, createdAt])
  @@map("roster_audit")
}

// ------------------------------------------------------------------
// The universal audit trail.
//
// RosterAudit above covers the VIP list and the blacklist, and for a long time it
// was the ONLY trail in the application. Everything else recorded an actor on the
// row it wrote - Ticket.issuedByName, ApiKey.createdByName, VenueMap.updatedByName,
// PartnerMember.addedByName - which answers "who last touched this" and cannot
// answer "what happened here this week", because there is nothing to order and
// nothing to read for a row that was deleted.
//
// This is that missing table: one append-only line per act, scoped the way the
// portal is scoped, so the hub can show a person everything that has happened
// across every area they hold.
//
// ---- Why it does not replace RosterAudit (yet) ----------------------------
//
// RosterAudit has TYPED columns - kind, robloxId, robloxUsername - and the page
// that renders it turns them into structured chips with a link to the Roblox
// profile. Flattened into `meta` below, that page gets worse, not better. It is
// also the only accountability record that exists, and `prisma db push` runs on
// every boot, which is not the tooling you want under a backfill.
//
// So both are written for now, which costs exactly one insert because all three
// roster writes already funnel through one helper (actions/portal.ts). Once this
// table holds ~90 days of ROSTER_ENTRY rows and /audit renders from it, RosterAudit
// becomes read-only history and can be dropped. That is the plan; without this
// paragraph it would just be a duplicate nobody dared touch.
// ------------------------------------------------------------------
enum AuditAction {
  CREATED
  UPDATED
  DELETED
  PUBLISHED
  ARCHIVED
  /// Access given to a person - a partner member, a SHASHA grant.
  GRANTED
  /// Access or a credential taken away - a member removed, a key revoked.
  REVOKED
  CHECKED_IN
  ISSUED
  VOIDED
}

enum AuditTarget {
  ROSTER_ENTRY
  API_KEY
  MEMBER
  EVENT
  TICKET
  TIER
  VENUE_MAP
  POST
  CAREER
  APPLICATION
  CONTENT
  GUIDE
  ASSET
  SURVEY
  ENQUIRY
  MERCH
  TEAM
  TESTIMONIAL
  /// A hand-authored accounting document - an invoice, payroll slip, receipt or
  /// credit note. Every state change on one is money changing hands on the record,
  /// which is precisely the kind of write this trail exists for.
  ACCOUNTING_DOCUMENT
  /// A payment request raised on pay.ronation.live and answered on accounts. Audited
  /// for the ACCEPT and DECLINE, not the submission: a client asking for money is not a
  /// company act, but agreeing to it is - and it is the one place a document gets raised
  /// on the strength of something somebody outside the company typed.
  PAYMENT_REQUEST
}

/// Which door the write came through. Presentation and filtering only - it
/// authorises nothing, and must never be read to decide anything.
enum AuditActorKind {
  /// A person in portal.ronation.live.
  PORTAL
  /// A person in /company on the main site.
  COMPANY
  /// An API key, on behalf of a game server. actorId is the ApiKey id.
  API
  /// Us - a scheduled job, a migration, a cascade.
  SYSTEM
}

model AuditLog {
  id String @id @default(cuid())

  /// "company", "shasha", or a partner slug - the SAME id namespace as
  /// RosterScope.id and HubArea.id, so readableScopes() filters this directly.
  /// Plain column, not an FK - see RosterEntry.partnerId.
  ///
  /// Scope follows the DATA, not the door: a ticket checked in at /company/door
  /// and one checked in at /shasha/door are the same act on the same row, and both
  /// land here as `partnerId ?? "shasha"`. "company" is reserved for rows that have
  /// no partnerId column at all - a survey, an enquiry, a team member.
  scope String

  action AuditAction
  target AuditTarget

  /// The row this is about, when there is one. Opaque, and never joined on: the
  /// row may since have been deleted, and this line still has to read.
  targetId String?

  /// What it was CALLED at the time. Frozen, for the same reason Ticket.tierName
  /// is - renaming a key must not silently rewrite its history.
  targetName String

  actorId   String
  actorName String
  actorKind AuditActorKind @default(PORTAL)

  /// One human sentence, written at the call site. The feed renders this and
  /// nothing else, so it has to stand on its own without the columns around it.
  summary String @db.Text

  /// Structured extras for a detail view: { before, after, role, scopes }.
  /// Never rendered raw, and nothing authorises off it.
  meta Json?

  createdAt DateTime @default(now())

  /// The feed's index, and the one that matters: every read filters on scope and
  /// orders by time.
  ///
  /// All three are PLAIN indexes. `prisma db push` runs on every boot and silently
  /// drops partial indexes and CHECK constraints, so nothing here may depend on
  /// one - the same warning Ticket.seatKey carries.
  @@index([scope, createdAt])
  @@index([scope, target, createdAt])
  /// "what has this API key actually done" - for the key health surface, once the
  /// /api/v1 write routes log with actorKind: API.
  @@index([actorId, createdAt])
  @@map("audit_log")
}

// ------------------------------------------------------------------
// Who may use a partner's portal (portal.ronation.live/<slug>).
//
// SHASHA answers this from Roblox group rank - "the group IS the allowlist" -
// and that is the right shape when the org and the group are the same thing.
// A partner is a *different* organisation, so RNL cannot rank them in its own
// group, and a partner cannot be trusted to hand out access to RNL's
// infrastructure by promoting people in a group RNL does not control.
//
// So membership is explicit rows, granted by RNL. A partner slug in the
// registry grants nobody anything (the registry says so itself); THIS table is
// the grant. Revoking is deleting a row.
//
// A partner MAY additionally point at a Roblox group of their own - see
// `Partner.robloxGroupId` in the registry - in which case rank in that group
// tops up the roles below. The rows here always win; they are the floor.
// ------------------------------------------------------------------
enum PartnerRole {
  /// Read the lists. Change nothing.
  STAFF
  /// Add, edit and remove people on the lists.
  MANAGER
  /// A manager who can also grant and revoke other members.
  OWNER
}

model PartnerMember {
  id             String      @id @default(cuid())
  /// A slug from lib/partners/registry.ts. Plain column, not an FK - see RosterEntry.partnerId.
  partnerId      String
  robloxId       String // canonical Roblox user id - resolved server-side
  robloxUsername String
  displayName    String
  avatarUrl      String?
  role           PartnerRole @default(STAFF)
  addedById      String // the RNL admin or partner owner who granted this
  addedByName    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([partnerId, robloxId]) // one grant per person per partner
  @@index([partnerId, role])
  @@map("partner_members")
}

// ------------------------------------------------------------------
// Job applications submitted through a career page.
// ------------------------------------------------------------------
enum ApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}

model Application {
  id     String @id @default(cuid())
  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  careerId String

  /// Copied from the career this was submitted against, so the inbox can be
  /// listed and counted by org WITHOUT joining through careers on every read.
  /// It is derived, never submitted: the actions read it from the Career row.
  partnerId String?

  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  robloxUsername String
  discord        String?
  timezone       String?
  portfolio      String?
  message        String            @db.Text
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())

  @@index([careerId])
  @@index([partnerId, status])
  @@map("applications")
}

// ------------------------------------------------------------------
// A partner's editable homepage.
//
// Their site used to be hardcoded in app/p/[slug]/page.tsx - the hero, the about
// panel, the FAQ, all of it in the component. That meant every copy change was a
// deploy, and a partner could not fix a typo on their own site.
//
// Every column is optional, and the page falls back to the registry's own
// tagline/description when a row (or a field) is missing. So a partner with no
// row still renders exactly as they did before, and this is additive rather than
// a migration everyone has to complete before their site works again.
// ------------------------------------------------------------------
model PartnerContent {
  /// The partner slug. One row per partner, so the slug IS the key.
  partnerId String @id

  // Hero.
  heroKicker   String?
  heroTitle    String?
  heroSubtitle String? @db.Text
  heroImageUrl String?

  // The "what this is" panel.
  aboutKicker String?
  aboutTitle  String?
  aboutBody   String? @db.Text
  aboutNote   String? @db.Text

  /// [{ q, a }] - the accordion on the homepage. Json because it is a list of
  /// pairs of arbitrary length, which flat columns model badly. Validated with
  /// zod on the way in (lib/partners/content.ts), never trusted on the way out.
  faq Json?

  updatedAt     DateTime @updatedAt
  updatedByName String?

  @@map("partner_content")
}

// ------------------------------------------------------------------
// Uploaded files.
//
// The BYTES do not live here - they are written to the uploads volume and served
// straight off disk by Caddy (see the Caddyfile and lib/uploads.ts). This is the
// record ABOUT each file: who put it there, when, and which org it belongs to.
//
// It exists for two reasons. An upload is a write to RNL's infrastructure by
// somebody outside RNL, so it needs to be attributable - `url` alone, pasted into
// an event's thumbnailUrl, records nothing about who uploaded it. And a file with
// no row is an orphan: nothing lists it, nothing can clean it up, and the only way
// to find it is to walk the disk.
// ------------------------------------------------------------------
model MediaAsset {
  id String @id @default(cuid())

  /// A slug from lib/partners/registry.ts, or NULL for RNL's own. Same convention
  /// as Event.partnerId. It is also the directory the file sits in on disk, which
  /// is what stops one partner from writing over another's.
  partnerId String?

  /// Public path: /uploads/<scope>/<id>.<ext>. What goes in thumbnailUrl/coverUrl.
  url String @unique

  /// The name the file had on the uploader's machine. Display only - NEVER used
  /// to build the path on disk (that would be a directory-traversal hole).
  filename String

  /// Sniffed from the file's magic bytes, not from what the browser claimed.
  mime String
  size Int

  uploadedById   String // Roblox id
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([partnerId, createdAt])
  @@map("media_assets")
}

// ------------------------------------------------------------------
// API keys - how a Roblox experience talks to the door.
//
// Before this table there was exactly one key, GAME_API_KEY, an env var on the
// server. That was fine while the only caller was RNL's own game. It stops being
// fine the moment a partner is handed a key for THEIR experience, because a
// single global secret has no scope: whoever holds it can verify, redeem, issue
// and void tickets for every show RNL runs, including other partners'. The events
// endpoint has carried a comment saying exactly this, unfixed, for months.
//
// So: a key is a row, it belongs to one organisation, and it carries a list of
// the things it may do.
//
//   partnerId  WHOSE tickets it can see. A registry slug, or NULL for RNL's own -
//              the same convention as Event.partnerId, which is what makes the
//              scope check a single equality against the event. A key cannot read,
//              redeem or void a ticket for a show that is not its org's. This is
//              enforced server-side, from the key; the caller cannot ask for a
//              wider scope, because there is nowhere to ask.
//
//   scopes     WHAT it may do. Read-only for a lobby board, verify+redeem for the
//              door, issue for a giveaway bot. A door key that leaks cannot mint
//              tickets; an issue key that leaks cannot void them.
//
// The SECRET is not here. `hash` is a SHA-256 of the full token, and the token is
// shown exactly once, at creation, and never again - losing it means minting a new
// one, which is the correct trade and the one every other API makes. SHA-256 and
// not bcrypt because the token is 160 bits of CSPRNG output, not a password: there
// is nothing to brute-force and a slow hash would just tax every request.
//
// `keyId` is the public half. It is embedded in the token (rnl_<keyId>_<secret>)
// so a lookup is one indexed read rather than a scan of every hash in the table,
// and it is safe to print in a UI, a log line or an audit row.
// ------------------------------------------------------------------
enum ApiKeyScope {
  /// GET /api/v1/events, GET /api/v1/events/:id - the line-up, capacity, tiers.
  EVENTS_READ
  /// POST /api/v1/tickets/verify - look, don't touch.
  TICKETS_VERIFY
  /// POST /api/v1/tickets/redeem - check somebody in at the door.
  TICKETS_REDEEM
  /// POST /api/v1/tickets/reserve and /gift - hand out a free ticket.
  TICKETS_ISSUE
  /// POST /api/v1/tickets/purchase - assert that somebody paid Robux, and issue
  /// the paid ticket. The heaviest scope in the list: nothing on our side can
  /// check the claim. See TicketPurchase.
  TICKETS_PURCHASE
  /// POST /api/v1/tickets/void and /revoke - take a ticket away.
  TICKETS_VOID

  /// POST + DELETE + GET /api/v1/intents - HOLD a seat while a player decides.
  ///
  /// Its own scope, and deliberately NOT folded into TICKETS_PURCHASE - which is the
  /// obvious place to put it and the wrong one. TICKETS_PURCHASE's whole warning is that
  /// it can ASSERT A PAYMENT nothing on our side can check: "only give this to a place you
  /// would trust with your own Robux". Holding a chair for ten minutes cannot take a penny
  /// off anybody.
  ///
  /// So a lobby board, a walk-up booth or a seat-map kiosk - anything that needs to keep a
  /// chair warm while somebody makes up their mind - gets THIS, and never the scope that
  /// could mint itself a free VIP ticket.
  INTENTS_WRITE

  /// POST /api/v1/discord/link, POST /discord/unlink, GET /discord/link - tie a Roblox
  /// account to a Discord one via the rotating code shown at /account/link. Touches no
  /// tickets and no money: it is the scope a Discord bot holds, and nothing else.
  DISCORD_LINK
}

model ApiKey {
  id String @id @default(cuid())

  /// The org this key belongs to: a slug from lib/partners/registry.ts, or NULL
  /// for RO. Nation LIVE's own. Plain column, not an FK - see RosterEntry.partnerId.
  partnerId String?

  /// What it is for, in the owner's words. "Main experience - door scanner".
  name String

  /// The public half of the token, and the only half we can ever show again.
  keyId String @unique

  /// SHA-256 (hex) of the whole token. Never the token itself.
  hash String

  scopes ApiKeyScope[] @default([])

  /// Who minted it. A Roblox id - the portal user, never the key itself: a key
  /// cannot mint another key, and there is no endpoint that would let it.
  createdById   String
  createdByName String

  /// Touched on use, best-effort and deliberately imprecise (see lib/apikey.ts).
  /// It answers "is this key still in use, or can I delete it?" - nothing more.
  lastUsedAt DateTime?

  /// Revoked keys are kept, not deleted: `keyId` stays claimed, and the audit
  /// trail on TicketPurchase.apiKeyId still resolves to a name. A revoked key
  /// authenticates nothing - the resolver refuses it before the hash is compared.
  revokedAt     DateTime?
  revokedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, revokedAt])
  @@map("api_keys")
}

// ------------------------------------------------------------------
// Internal guides - portal.ronation.live/docs/guides.
//
// Running an event, working the door, how the systems fit together. Authored at
// /company/docs (requireCompanyUser, rank 245+) and READ by anybody with a door
// on this platform at all: SHASHA staff, including the read-only tier, or a
// partner's crew. See lib/docs-guard.ts.
//
// Deliberately NO partnerId, unlike Post and Career. There is one library, and
// it is RNL's. A nullable scope column "just in case" is not free: it is a filter
// that every future read has to remember, and the one that forgets is the one
// that shows a partner somebody else's guide. If a partner library is ever
// wanted, it is a new decision - not a column somebody left open.
// ------------------------------------------------------------------
enum GuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Which docs AREA a guide belongs to. One model, one editor, one reader for all
/// three - the kind only decides which heading in the nav it files under, so
/// adding an area is a value here and a page, never a parallel table. Existing
/// rows default to GUIDE, so this column is a safe additive `db push`.
enum GuideKind {
  GUIDE
  RUNBOOK
  ONBOARDING
}

model Guide {
  id String @id @default(cuid())

  /// Globally unique - one library, so unlike Post.slug this needs no scope, and
  /// carries none of the NULL-tuple caveat that comes with one.
  slug    String  @unique
  title   String
  excerpt String?
  body    String  @db.Text

  /// The heading it sits under on /docs/guides. Free text rather than an enum:
  /// the sections are editorial ("Running a show", "The systems"), and an enum
  /// would make adding one a deploy.
  section String @default("General")

  /// Which docs area it appears under - Guides, Runbooks, or Onboarding. See
  /// GuideKind. Existing rows are GUIDE.
  kind GuideKind @default(GUIDE)

  status GuideStatus @default(DRAFT)

  /// Ascending within a section. Ties break on title.
  order Int @default(0)

  authorRobloxId String?
  authorName     String
  publishedAt    DateTime? // set the first time it goes PUBLISHED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([kind, status, section, order])
  @@map("guides")
}

// ------------------------------------------------------------------
// Brand assets - logos, artwork, guideline PDFs. Uploaded at /company/docs and
// listed at portal.ronation.live/docs/brandassets.
//
// `visibility` decides WHERE THE BYTES LIVE, not merely who sees the row:
//
//   PUBLIC    written to UPLOAD_DIR and served by Caddy off the shared volume at
//             /uploads/rnl/<uuid>.<ext>. A shareable URL is the FEATURE here - a
//             partner pasting a logo link into a Discord is the entire point, and
//             it keeps working when they are signed out, which is when they will
//             be using it.
//
//   INTERNAL  written to PRIVATE_UPLOAD_DIR, a volume Caddy does not mount at
//             all. No URL serves it. It is streamed by app/files/[id]/route.ts,
//             which re-reads the session on every request, so a leaked link is
//             worth nothing to a stranger.
//
// That is why this is a column and not a folder convention: the serving path is
// derived from it, in exactly one place (brandAssetHref in lib/docs.ts), and
// there is no way to render an INTERNAL asset as a public URL by forgetting
// something.
//
// It carries its own file pointer rather than an FK to MediaAsset, whose `url` is
// @unique and documents the PUBLIC path. An internal file has no public path, so
// pointing at a MediaAsset would mean inventing a fake URL for it - and a fake
// URL is precisely the string somebody later drops into an <img src>.
// ------------------------------------------------------------------
enum AssetVisibility {
  PUBLIC
  INTERNAL
}

/// What a file IS, for filing. ASSET is the brand library (logos, artwork,
/// guideline PDFs); TEMPLATE is a reusable download (a run sheet, a spreadsheet,
/// a config). Same upload path, same viewer - the kind only chooses which docs
/// page it lists on. Existing rows default to ASSET, so this is a safe additive
/// `db push`.
enum AssetKind {
  ASSET
  TEMPLATE
}

model BrandAsset {
  id String @id @default(cuid())

  /// The heading it sits under. Free text, same reasoning as Guide.section.
  category    String  @default("Logos")
  title       String
  description String? @db.Text

  /// Brand asset, or reusable template/download. See AssetKind. Existing rows
  /// are ASSET.
  kind       AssetKind       @default(ASSET)
  visibility AssetVisibility @default(PUBLIC)

  /// "rnl/<uuid>.pdf" - relative to the root `visibility` selects. Never a URL,
  /// never absolute, and never built from a name the uploader chose: the stored
  /// name is a fresh UUID (lib/uploads.ts). Resolved against its root with a
  /// prefix check before anything is opened, all the same.
  storagePath String

  /// The name it had on the uploader's machine. Display and Content-Disposition
  /// only, sanitised at that point. NEVER used to build a path.
  filename String

  /// Sniffed from the magic bytes at upload, not taken from what the browser
  /// claimed. Content-Type is set from this, so it must never come from a client.
  mime String
  size Int

  /// Ascending within a category.
  order Int @default(0)

  uploadedById   String // Roblox id
  uploadedByName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind, visibility, category, order])
  @@map("brand_assets")
}

// ------------------------------------------------------------------
// Spent SSO tickets.
//
// A ticket is a 60-second JWT that authorise.ronation.live hands to another host
// so that host can mint its own session cookie (lib/sso.ts). It travels in a URL
// - so it lands in browser history, in a Referer, and quite possibly in somebody's
// access log. Three things make that survivable, and this table is the third:
//
//   • it expires in 60 seconds
//   • it is bound to ONE audience, so a ticket for the portal is inert anywhere else
//   • it can be spent exactly ONCE - this table
//
// The row IS the lock: `jti` is the primary key, so redeeming a ticket is an
// INSERT, and a replay is a unique-constraint violation rather than a check that
// somebody has to remember to write. Rows are deleted once they are past
// expiresAt; a ticket that old is refused on its exp anyway, so the table only
// ever holds a minute of traffic.
// ------------------------------------------------------------------
model SsoTicket {
  /// The ticket's jti claim. The primary key, on purpose - see above.
  jti String @id

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("sso_tickets")
}

// ------------------------------------------------------------------
// The merch shop - merch.ronation.live.
//
// RNL sells classic Roblox clothing through its Roblox group. Roblox takes the
// payment, on Roblox's own catalog page; this shop is a showcase that presents the
// item properly - on a character you can turn around - and then hands off. There
// is no cart here and no money, and there must never be: Robux cannot be charged
// from a website at all (see the note on `robuxTickets` in partners/registry.ts).
//
// Each row is HALF SYNCED, HALF CURATED, and the split is the important part:
//
//   synced   name, price, description, sale state, thumbnail. Overwritten from
//            Roblox on every sync. Never hand-edited - it would be silently undone.
//   curated  slug, collection, order, visible, texture. RNL's, and the sync never
//            touches them - a re-sync must not un-place a shelf or rot a link.
//
// A COLLECTION is not a row. It lives in lib/merch/collections.ts, because the
// middleware has to resolve a collection's brand on the edge - before Prisma
// exists - to paint /sleeptoken in Sleep Token's colours. Products need no such
// thing, so products are rows. That line is the whole reason for the split.
// ------------------------------------------------------------------

/// What the texture wraps onto. The numbers are Roblox's own assetTypeIds, and the
/// mapping is not guessable: 11 is a full-body Shirt and 2 is a T-Shirt (a decal on
/// the torso front). RNL's current merch is all type 11, despite being named "tee".
enum MerchKind {
  SHIRT // assetTypeId 11 - torso + both arms
  TSHIRT // assetTypeId 2  - a decal on the torso's front face only
  PANTS // assetTypeId 12 - both legs
}

model MerchProduct {
  id String @id @default(cuid())

  /// The Roblox catalog asset id - as a STRING, and this is not a style choice.
  /// Roblox ids passed 2^31 years ago (15340708457 is a live one), so an Int column
  /// would overflow. Every other Roblox id in this schema is a String for the same
  /// reason; the ids are opaque names, never arithmetic.
  assetId String    @unique
  kind    MerchKind

  // ---- synced from Roblox. Do not hand-edit: the next sync wins. ----
  name        String
  description String? @db.Text

  /// Null when Roblox reports no price - an off-sale item, or one sold only inside
  /// an experience. Nullable rather than 0, because "free" and "not purchasable"
  /// are different things and a shop that renders the second as the first is lying.
  priceRobux Int?
  forSale    Boolean @default(false)
  limited    Boolean @default(false)
  sales      Int     @default(0)

  /// A tr.rbxcdn.com URL. These ROTATE - the hash is stamped with a validity window
  /// (the "180DAY-" prefix on the ones we get today) - so this is a cache, not an
  /// identifier. Refreshed on every sync, and every reader must tolerate it being
  /// null or stale rather than rendering a broken image.
  thumbnailUrl String?

  syncedAt DateTime?

  // ---- curated by RNL. The sync never writes these. ----

  /// The URL segment: /sleeptoken/<slug>. Derived from the name ONCE, on first
  /// sync, and never re-derived - a shirt renamed on Roblox must not rot a link
  /// somebody has already pasted into a Discord. Same rule updateGuide follows.
  slug String @unique

  /// A Collection slug from lib/merch/collections.ts. NULL means unplaced, and an
  /// unplaced product is invisible no matter what `visible` says - it has no URL to
  /// be visible at. This is what makes the catalogue curated rather than a dump of
  /// whatever is in the group.
  collection String?

  order   Int     @default(0)
  visible Boolean @default(false)

  /// The classic clothing template, uploaded by RNL - the artwork the 3D viewer wraps
  /// onto the character.
  ///
  /// It is uploaded rather than fetched because Roblox will not give it to us:
  /// assetdelivery 401s without a logged-in cookie, and so does the official 3D
  /// thumbnail. RNL owns this artwork, so the upload is the honest path and the one
  /// that cannot expire. Null is fine and common - the product page falls back to
  /// Roblox's flat thumbnail and still sells the shirt.
  ///
  /// ---- A PATH, ON THE PRIVATE VOLUME. NOT A URL. ----
  ///
  /// This is "rnl/<uuid>.png", relative to PRIVATE_UPLOAD_DIR - the volume that is
  /// deliberately not mounted into Caddy (see lib/uploads.ts, and the DO NOT ADD IT in
  /// docker-compose.yml). There is no URL that returns this file, and that is the point:
  /// a classic Roblox shirt IS its template, so a public URL for it is a free copy of the
  /// product for anybody who views source. It used to be exactly that.
  ///
  /// The only readers are lib/merch/plate.ts, which hands out one shredded face of one
  /// cube at a time through a sealed token, and the staff-only watermarked preview in
  /// api/merch/texture-preview. Nothing else may open it, and nothing may put it back in
  /// an <img src>.
  texturePath String?

  /// DEAD. The public /uploads URL the template used to be served from.
  ///
  /// Kept as a column, empty, purely so `prisma db push` does not need --accept-data-loss
  /// on the deploy that moves the artwork to the private volume. scripts/privatise-
  /// textures.ts moves the file, fills texturePath, and nulls this. Nothing reads it; do
  /// not write to it, and do not put a template back on the public volume.
  textureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, collection, order])
  @@map("merch_products")
}

// ------------------------------------------------------------------
// The crew.
//
// /team used to be six people hardcoded in the page component - names, roles,
// blurbs and Roblox handles, none of which belonged to anybody. Inventing a
// statistic is one thing; inventing a PERSON, giving them a job title at a real
// company and a handle on a real platform, is another, and it is the reason this
// table exists rather than a tidier array.
//
// The defence against it happening again is the shape of the row: a crew member
// is IDENTIFIED BY A ROBLOX ID, resolved server-side through Roblox's own user
// API by the picker in /company/team. You cannot type a person into this table.
// You can only find one.
//
// No partnerId. This is RNL's crew, and a nullable scope column "just in case" is
// a filter every future read has to remember - see the note on Guide.
// ------------------------------------------------------------------
model TeamMember {
  id String @id @default(cuid())

  /// The canonical Roblox id. Unique: one card per person, so adding somebody
  /// twice updates them instead of producing a duplicate nobody notices.
  robloxId       String  @unique
  robloxUsername String
  displayName    String
  /// Roblox's headshot, cached when they were picked. It CAN rot - Roblox rotates
  /// these URLs - so every reader tolerates null and a broken image, exactly as
  /// MerchProduct.thumbnailUrl does. The initials fallback is the design, not the
  /// error state.
  avatarUrl      String?

  /// "Lead Stage Builder". Free text and editorial - it is a job title, not an enum.
  role String

  /// "Build", "Talent", "Tech". Free text on purpose: an enum would make adding a
  /// department a schema migration and a deploy, which is absurd for a heading.
  department String @default("Crew")

  /// Optional. A name and a role is already a complete card; forcing a paragraph
  /// out of somebody who does not want to write one is how you get filler.
  bio String? @db.Text

  order Int @default(0)

  /// Off the site, but still on the books. The ROW SURVIVES a hide, so somebody
  /// who steps back for a season is un-hidden later rather than re-added from
  /// scratch - and their order and blurb come back with them.
  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
  @@map("team_members")
}

// ------------------------------------------------------------------
// What the crowd actually said.
//
// The homepage carried five of these as a hardcoded array, under a heading
// reading "What the crowd said", written by nobody and said by nobody.
//
// `published` DEFAULTS TO FALSE, and that default is the entire point of the
// table: nothing reaches the homepage because it was typed into a form. Somebody
// reads it and decides. A quote is a claim about a real person's opinion, and the
// cost of getting one wrong is not a broken layout.
// ------------------------------------------------------------------
model Testimonial {
  id String @id @default(cuid())

  body String @db.Text

  /// Who said it.
  ///
  /// A plain string, and deliberately NOT resolved against Roblox the way a crew
  /// member or a roster entry is. This is an ATTRIBUTION, not an identity: the
  /// person may have written in on Discord, or said it on a stream, or filled in a
  /// post-show survey under a name they have since changed. A lookup here would
  /// refuse perfectly real quotes for being hard to verify, which is how you end up
  /// back at inventing them.
  author String

  /// "Front row", "Ticket holder". Optional flavour, never load-bearing.
  meta String?

  /// The show it is about, when it is about one.
  ///
  /// SetNull, NOT Cascade. A quote about a show that has since been archived is
  /// still a quote somebody said - deleting their words because the event row went
  /// away would be a bug that looks like housekeeping.
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  /// The survey answer this was lifted from, if it was lifted from one.
  ///
  /// The best quotes RNL will ever have are already in this database. A LONG_TEXT answer
  /// to "how was the show?" was typed by a REAL, SIGNED-IN ROBLOX ACCOUNT - the username
  /// is denormalised onto SurveyResponse precisely so it survives a rename - which makes
  /// it better attributed than anything a person could paste into an admin form.
  ///
  /// Unique, so promoting the same answer twice is impossible rather than merely
  /// discouraged: the second attempt hits the constraint instead of quietly producing a
  /// duplicate quote on the homepage. It is a plain String, not a relation, because the
  /// quote must OUTLIVE the survey - deleting a survey cascades its answers away, and a
  /// person's words are not the survey's to delete.
  sourceAnswerId String? @unique

  published Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("testimonials")
}

// ------------------------------------------------------------------
// Somebody wants to talk to us.
//
// Every "work with us" and "book us" call to action on this site used to be a link
// to Discord, and /contact had no form at all - which is fine for a fan and useless
// for a group leader with a launch to run and a budget to spend.
//
// ---- Why sending one requires a Roblox sign-in --------------------------------
//
// This is a PUBLIC, UNAUTHENTICATED WRITE to the production database, which is the
// most-spammed object on the web. Applications get away with it because a job
// application is a niche target; a contact form is not.
//
// So the action behind it requires a session (lib/session.ts), which costs a real
// visitor one click - they are on a Roblox site, signing in with Roblox - blocks
// essentially every bot, and fills `userId` for free. The one person it turns away
// is a journalist with no Roblox account, and they get the BETTER channel: /press
// carries a plain email address, precisely so it does not depend on this.
// ------------------------------------------------------------------
enum EnquiryKind {
  BOOKING
  PRESS
  PARTNERSHIP
  GENERAL

  /// A privacy / data request submitted from /legal/data-request/request/new. Files
  /// into the same inbox as everything else (it is still a message from outside that a
  /// human has to action), but tagged so legal requests - which carry statutory
  /// deadlines - can be filtered and triaged apart from a booking. See
  /// app/actions/data-requests.ts.
  DATA
}

enum EnquiryStatus {
  NEW
  READING
  REPLIED
  CLOSED
}

model Enquiry {
  id String @id @default(cuid())

  /// Which pile it lands in. SAFE to take from the form body, unlike a partner
  /// scope: it authorises nothing at all, it only files the row.
  kind   EnquiryKind   @default(GENERAL)
  status EnquiryStatus @default(NEW)

  name String

  /// At least one way to reply is required - and that is enforced in the ACTION,
  /// not here. "One of two columns must be present" needs a CHECK constraint, and
  /// `prisma db push` silently drops hand-written constraints on every boot (the
  /// same trap documented on Career.slug). A rule the database forgets on Tuesday
  /// is worse than a rule the code enforces every time.
  email   String?
  discord String?

  /// Who they were signed in as. SetNull: an enquiry outlives an account.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  subject String
  message String @db.Text

  /// Booking only, and optional even then.
  ///
  /// PLAIN STRINGS, not a DateTime and an Int. "Some time in March" and "a few
  /// hundred?" are the honest answers at first contact, and a date picker that
  /// refuses them is a form that loses the lead. Pin it down in the reply.
  eventDate String?
  scale     String?

  /// A crew note on the row. Never shown to the person who sent it.
  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
  @@map("enquiries")
}

// ------------------------------------------------------------------
// Fixed-window rate-limit counters.
// ------------------------------------------------------------------
/// One row per bucket key, updated in place - so this table is bounded by the
/// number of DISTINCT keys (users, API keys), not by request volume, and never
/// grows with traffic.
///
/// Written only by lib/rate-limit.ts, through a single atomic upsert. There is no
/// application read path and no relation to anything else: it is throwaway state
/// that merely has to outlive a process restart and be shared across processes -
/// which is exactly why it is a table and not an in-memory map. There is more than
/// one web process, and a counter in one cannot see the requests hitting another.
model RateLimit {
  /// The bucket: "enquiry:<uid>", "reserve:<uid>", "apikey:<id>".
  key     String   @id
  /// Hits so far in the current window.
  count   Int      @default(0)
  /// When the window ends; the next hit after this resets count to 1.
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

// ------------------------------------------------------------------
// A payout invoice RNL issues to a partner.
//
// The one place money leaves the building, made a DOCUMENT. Only the company mints
// these - the /company/invoices pages are rank-gated (lib/company.ts) - and a partner
// may read the ones ISSUED to them but can mint none of their own. That is the whole
// reason the row exists: the old settlement page let a partner's own manager conjure a
// live statement from the ledger, and a statement about what you are owed should be
// handed to you by the party that owes it, not printed by you.
//
// ---- Frozen at issue ------------------------------------------------------
//
// Every figure below is a SNAPSHOT taken from lib/settlement at the moment of
// generation, never a live read afterwards. An invoice is a promise about a past
// window; a late sale that lands in that month must not silently change a number the
// partner has already been shown. Same rule Ticket.tierName and MemberNotification.body
// follow, and for the same reason. lib/invoices.ts is the only writer, and it snapshots
// on the way in and reconstructs a Settlement on the way out.
model Invoice {
  id String @id @default(cuid())

  /// The partner this is payable to - the `slug`, which is also Event.partnerId for a
  /// partner's shows. NOT an FK: partners are a code registry (partners/registry.ts),
  /// not a table, so this is validated through partnerBySlug() at the write, never by
  /// the database. Always a real partner - RNL's own revenue (eventScope null) has no
  /// external payee and so no invoice.
  partnerId String

  /// The human invoice number a person reads on the page, e.g. RNL-SLEEPTOKENRO-2026-07.
  /// The URL keys on `id` (a cuid); this is display only, and is snapshotted like the
  /// rest so re-slugging a partner can never rewrite an issued document.
  number String

  /// Who it is payable to, frozen at issue - the partner's display name at that moment.
  payeeName String

  /// The billing window. `tag` drove the number and the ledger query; `label` is the
  /// human copy ("July 2026", "All time").
  periodTag   String
  periodLabel String

  status InvoiceStatus @default(DRAFT)

  // ---- The frozen fee stack, in Robux ------------------------------------
  //
  // Snapshotted from payoutFor() so the reconciliation it guarantees -
  // robloxFee + rnlFee + partnerPayout === gross - still holds months later, even if
  // the live ledger for this window has moved on.
  gross         Int
  robloxFee     Int
  afterRoblox   Int
  rnlFee        Int
  partnerPayout Int

  /// True when the settlement was capped (more ledger rows than the cap) at issue, so
  /// the totals cover a window rather than the whole period. Carried onto the document.
  capped Boolean @default(false)

  /// The per-show line items, frozen as JSON:
  /// [{ eventId, title, startsAt (ISO), payments, robux }]. A relation would re-read
  /// live titles and dates and let a since-deleted show vanish off an issued invoice -
  /// exactly what a snapshot exists to prevent.
  lineItems Json

  /// Who generated it, and when. robloxId is not an FK - staff are Roblox accounts,
  /// not necessarily User rows - and the name is snapshotted so a later rename does not
  /// rewrite the issuer on a document already sent.
  issuedByRobloxId String
  issuedByName     String
  issuedAt         DateTime @default(now())

  /// When the company SENT it (status → SENT). Null while it is still a DRAFT the
  /// partner cannot see.
  sentAt DateTime?

  /// When the partner first OPENED it in their portal. Null until then - this single
  /// timestamp is what drives the "new invoice" indicator on their payouts page, the
  /// in-portal notice that a payout has arrived.
  openedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status, issuedAt])
  @@map("invoices")
}

enum InvoiceStatus {
  /// Generated, visible to the company only. Figures are already frozen.
  DRAFT
  /// Sent to the partner. Now readable in their portal; still immutable.
  SENT
}

// ------------------------------------------------------------------
// The accounting desk.
//
// Invoice (above) is a DERIVED document: it is generated from the ticket ledger and
// nobody types a figure into it. Everything here is the opposite - hand-authored
// documents for the money that never touches TicketPurchase. Paying a builder,
// billing a sponsor, receipting a payment, crediting back a mistake.
//
// One table for four document kinds, because they differ in WORDING far more than in
// SHAPE: all four are "a payee, some lines, a total, frozen at issue". Four tables
// would be four near-identical schemas and four near-identical write paths. What
// actually varies per kind - the heading, who owes whom, the number prefix - is
// config in lib/accounting/kinds.ts, not columns here.
//
// The same freeze rule as Invoice, for the same reason: a DRAFT is editable, and the
// moment it is ISSUED every figure is a promise already made to somebody. There is no
// edit path after that - a CREDIT_NOTE is how an issued document is corrected, which
// is also how real books work. lib/accounting/documents.ts is the only writer.
// ------------------------------------------------------------------

enum DocumentKind {
  /// RNL bills someone. A sponsor, a brand, a partner for something off-ledger.
  INVOICE
  /// RNL pays someone. A builder, an artist, a dev - "here is what we owe you and why".
  CONTRACTOR_PAYMENT
  /// Proof money moved. Usually against an INVOICE or CONTRACTOR_PAYMENT via `relatedId`.
  RECEIPT
  /// Cancels or partly refunds an already-issued document. The ONLY way to correct one.
  CREDIT_NOTE
  /// Money back to a ticket holder. Written AGAINST a ticket rather than typed, and
  /// capped at what that ticket was actually paid for. See lib/accounting/refunds.ts.
  TICKET_REFUND
}

enum DocumentStatus {
  /// Being written. The only status in which anything may be edited.
  DRAFT
  /// Frozen and numbered. Readable on its share link.
  ISSUED
  /// Settled. Terminal, and reached only from ISSUED.
  PAID
  /// Cancelled. Terminal. The document still exists and still reads - a void
  /// document is history, not a deletion, and its number is never reused.
  VOID
}

model AccountingDocument {
  id String @id @default(cuid())

  kind   DocumentKind
  status DocumentStatus @default(DRAFT)

  /// The human number - RNL-INV-2026-0007. Assigned at ISSUE, not at creation, so a
  /// discarded draft never burns a number and the issued sequence has no holes.
  /// Null while DRAFT. Unique when set.
  number String? @unique

  // ---- The other party ---------------------------------------------------
  //
  // Free text, all of it. A contractor is a Roblox account, a Discord handle or an
  // email - not necessarily a User row - so there is no FK here and there should not
  // be. What is typed is what prints.

  /// Who the document is to. The payee on a payment, the bill-to on an invoice.
  counterpartyName   String
  /// How to reach or identify them - @handle, roblox id, email. Optional, prints under the name.
  counterpartyRef    String?
  /// Free address / extra detail block. Optional.
  counterpartyDetail String?

  /// Set when the counterparty above IS a PartnerAccount the staff picked in the builder,
  /// rather than free text. A PLAIN column, not an FK - same convention as Invoice.partnerId
  /// and ticketId: the document snapshots the party's name into counterpartyName, and this is
  /// only ever used one way - the filter behind a partner's /partner accounting tab, which
  /// lists the documents raised against their entity (see listDocumentsForPartnerAccount).
  /// Null for every free-text document, which is still the ordinary case.
  partnerAccountId String?

  /// One line saying what this document is FOR - "Stage build, July shows". Prints
  /// under the heading, and is what the list is scanned by.
  title String

  /// Set when this corrects or settles another document (RECEIPT → its invoice,
  /// CREDIT_NOTE → what it credits). The id of another AccountingDocument. Not an FK:
  /// same reason as the snapshot fields - the pointer must survive whatever happens to
  /// the target, and nothing is ever joined through it.
  relatedId String?

  // ---- Ticket refunds ----------------------------------------------------
  //
  // Set only on a TICKET_REFUND. Everything else leaves both alone.

  /// The ticket being refunded. A PLAIN column, not a relation, and that is load-bearing
  /// twice over: TicketPurchase cascades on ticket delete, and a refund document must
  /// outlive the thing it refunds - the whole point of a financial record is that it
  /// survives the tidying up. Nothing is ever joined through it; the document snapshots
  /// what it needs (code, show, holder) into its own title and lines at creation.
  ticketId String?

  /// Whether issuing this refund should also CANCEL the ticket.
  ///
  /// True for the ordinary full refund - money back means the seat comes back, and a
  /// refunded ticket that still scans at the door is somebody attending for free.
  /// False for a partial or goodwill refund, where they keep their seat and get some
  /// Robux back. Stored rather than inferred from the amount, because "full refund"
  /// and "void the ticket" are two decisions and conflating them silently is how a
  /// gesture of goodwill accidentally cancels somebody's night out.
  voidsTicket Boolean @default(true)

  // ---- The money, all integer Robux --------------------------------------
  //
  // Robux is the only currency this org handles, so there is no currency column -
  // adding one later would be a schema change on immutable rows, but inventing one now
  // for money that does not exist would be worse. See lib/settlement.ts.

  /// The lines, frozen as JSON:
  /// [{ description, qtyCenti, unitRobux, amountRobux }]
  /// qtyCenti is quantity × 100, so "7.5 hours" is 750 and everything stays integer.
  /// amountRobux is computed server-side from the other two and stored, never posted.
  lineItems Json

  /// Sum of the line amounts.
  subtotal Int

  /// An optional single adjustment off the subtotal - a deduction, an advance already
  /// paid, a discount. MAY be negative. Its label is what prints beside it.
  adjustmentLabel String?
  adjustmentRobux Int     @default(0)

  /// subtotal + adjustmentRobux. Stored rather than derived so the arithmetic on an
  /// issued document can never be re-run differently by a later version of this code.
  total Int

  // ---- Terms and notes ---------------------------------------------------

  /// "Due on receipt", "Net 14", "Paid via group payout". Free text, prints in the terms block.
  terms String?
  /// Anything else that should print - bank/handle for payment, scope caveats.
  notes String?

  /// The date the document is dated - defaults to issue, but a payment for last month's
  /// work should be able to say so. Separate from issuedAt, which is when the row froze.
  documentDate DateTime  @default(now())
  /// When payment is expected. Optional and kind-dependent.
  dueDate      DateTime?

  // ---- The share link ----------------------------------------------------

  /// The unguessable path segment at accounts.ronation.live/document/<kind>/<token>.
  /// Minted at ISSUE, alongside the number - a draft has no token because a draft has
  /// nothing to share.
  ///
  /// This is a BEARER capability: anyone holding it reads the document, which is the
  /// point (a contractor has no account here). It is therefore high-entropy, it is
  /// never listed anywhere public, and the page it serves is noindex. Revoking is
  /// rotating: see rotateShareToken().
  ///
  /// Length is NOT constrained here, deliberately. Tokens minted from now on are 40
  /// characters (lib/accounting/documents.ts); the 24-character ones minted before that
  /// are still live links on documents somebody has already been sent, and lookup is an
  /// exact match on this column, so both simply work. A CHECK constraint on the length
  /// would break every link already in the wild to buy nothing.
  shareToken String? @unique

  /// When the link was first opened, and how many times. Courtesy telemetry for the
  /// company - "have they seen it yet" - and nothing authorises off either.
  firstViewedAt DateTime?
  viewCount     Int       @default(0)

  // ---- Provenance --------------------------------------------------------

  /// Who created the draft, and who froze it. Snapshotted names, like Invoice: a later
  /// rename must not rewrite a document already sent.
  createdByRobloxId String
  createdByName     String
  issuedByRobloxId  String?
  issuedByName      String?

  /// When it froze. Null while DRAFT.
  issuedAt   DateTime?
  /// When it was marked settled. Null unless PAID.
  paidAt     DateTime?
  /// When it was cancelled, and why. Null unless VOID.
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The list view: newest first, filtered by kind or status.
  @@index([kind, status, createdAt])
  @@index([status, createdAt])
  @@index([relatedId])
  /// The double-refund guard reads this on every refund: "what has already been paid
  /// back on this ticket". It runs before every refund is written, so it is indexed.
  @@index([ticketId])
  /// The partner's accounting tab reads this: "every issued document raised against my
  /// entity". Scoped read, so it is indexed - the mirror of Invoice's [partnerId, ...] index.
  @@index([partnerAccountId])
  @@map("accounting_documents")
}

/// One row per (kind, year), holding the last number handed out.
///
/// Document numbers have to be gapless and unique per kind per year, and `count() + 1`
/// is a race: two people issuing at once both read the same count and mint the same
/// number. This table makes the increment atomic - an `update` with `increment` inside
/// the issue transaction, which Postgres serialises on the row lock. See nextNumber().
model DocumentCounter {
  kind DocumentKind
  year Int
  /// The last number issued for this (kind, year). Starts at 0; first issue gets 1.
  seq  Int          @default(0)

  @@id([kind, year])
  @@map("document_counters")
}

// ---- Partner accounts ------------------------------------------------------
//
// A commercial PARTNER - a party whose merch and tickets RNL sells - or a POTENTIAL
// partner we are in talks with. They sign in at portal.ronation.live/partner to read
// the agreements they accept on joining and, once a full PARTNER, to see the accounting
// documents RNL has raised against them (payouts, billables, receipts, credit notes).
//
// This is NOT the multi-tenant partner system. Those partners (lib/partners/registry.ts)
// are code-registry brands with their own subdomain, theming and PartnerMember crew. A
// PartnerAccount is a plain business relationship: no site, no brand, no portal of their
// own - just a door onto /partner. The two share the word "partner" and nothing else.
//
// The split into an entity (PartnerAccount) and its logins (PartnerAccountMember) is the
// same shape the tenant system uses (a Partner + its PartnerMember rows), and for the same
// reason: a partner can be a company with several people who each sign in with their own
// Roblox account, and the accounting is scoped to the ENTITY, not to whoever happens to be
// looking at it.

enum PartnerAccountKind {
  /// An individual. One member, usually - their own Roblox account.
  PERSON
  /// A business. May have several members (representatives) who each sign in.
  COMPANY
}

enum PartnerAccountStatus {
  /// A live partner. Reads the agreements AND their accounting.
  PARTNER
  /// In talks. Reads the agreements only - no accounting until they become a PARTNER.
  POTENTIAL
}

model PartnerAccount {
  id String @id @default(cuid())

  kind   PartnerAccountKind
  /// The person's name or the company name. This is what prints on a document raised
  /// against them (copied into AccountingDocument.counterpartyName at creation).
  name   String
  status PartnerAccountStatus @default(POTENTIAL)

  /// Anything the company needs to remember - the contact, the deal, where they came from.
  note String?

  /// Who created the entity, snapshotted like everywhere else in this schema.
  createdByRobloxId String
  createdByName     String

  members PartnerAccountMember[]

  // ---- The partner programme ------------------------------------------------
  //
  // An entity may have been INVITED (partner.ronation.live/invite/<code>), is ONBOARDED
  // once, and may have any number of SITE BRIEFS raised against it - one per site RNL
  // builds for them. All three live at the bottom of this file.
  invites    PartnerInvite[]
  onboarding PartnerOnboarding?
  siteBriefs PartnerSiteBrief[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("partner_accounts")
}

model PartnerAccountMember {
  id String @id @default(cuid())

  partnerAccountId String
  partnerAccount   PartnerAccount @relation(fields: [partnerAccountId], references: [id], onDelete: Cascade)

  robloxId    String // canonical Roblox user id - resolved server-side
  username    String
  displayName String
  avatarUrl   String?

  /// Who added this login, snapshotted.
  addedByRobloxId String
  addedByName     String

  // ---- The payment terms this login accepted -----------------------------
  //
  // pay.ronation.live will not open until these are set to the current version. The
  // guard is requirePayUser() and the gate is app/pay/terms - see lib/accounting/
  // pay-terms.ts for what is being accepted and why there is a gate at all.
  //
  // Three columns rather than one, for the reason Ticket.termsSnapshot exists: a
  // timestamp on its own records agreement to a text nobody can reconstruct
  // afterwards, and that is precisely the half that matters when it is disputed. So
  // WHEN, WHICH VERSION, and A FROZEN COPY of what they were shown.
  //
  // On the MEMBER, not the PartnerAccount, and deliberately. Accepting is a personal
  // act by the human who is signed in - "I am authorised to accept these on behalf of
  // this account" is one of the two things they tick - so a second login added to the
  // same entity next year accepts for themselves. Hanging it off the entity would let
  // one person's click bind a colleague who never saw the words.

  /// When this person passed the gate. NULL means they never have.
  payTermsAcceptedAt DateTime?

  /// PAY_TERMS_VERSION as it stood when they accepted. An older value is treated as
  /// no acceptance at all - that is the entire reason it is stored next to the date.
  payTermsVersion String?

  /// WHAT THEY ACTUALLY AGREED TO, one line per element, re-derived on the server at
  /// the moment of acceptance and never posted from the form.
  ///
  /// EMPTY on every membership written before this column existed, which the gate
  /// reads as "not accepted" and prompts for. No backfill: inventing an acceptance
  /// for somebody who was never asked would be worse than the gap, and would put a
  /// fabricated record in the one place that exists to be evidence.
  payTermsSnapshot String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One membership row per person per entity.
  @@unique([partnerAccountId, robloxId])
  /// v1: a Roblox account belongs to at most one partner entity, so the /partner guard is a
  /// single lookup by robloxId. If an agent ever needs to represent several partners, drop
  /// this and add an entity switcher - but do not widen it silently, because the guard and
  /// the accounting scope both assume one entity per login.
  @@unique([robloxId])
  @@map("partner_account_members")
}

// ---- Payment requests ------------------------------------------------------
//
// The two forms on pay.ronation.live, and the queue they land in on
// accounts.ronation.live. This is the ONLY thing a counterparty can write anywhere in
// the accounting system, and it is deliberately not much: an ASK.
//
// ---- Why a request is not a document ---------------------------------------
//
// An AccountingDocument is RNL's own record - numbered from a shared counter, frozen at
// issue, and never editable again. If a partner could create one, a partner could mint a
// number out of RNL's sequence and put a figure of their choosing on RNL's letterhead.
//
// So a request carries no number, no letterhead and no share token. It is a message with
// a shape: who, how much, what for, which way the money goes. Staff read it, and if they
// agree, they RAISE a document from it - which is a separate, audited act by a person
// with company rank (see convertRequestAction). The link back is documentId, written at
// that moment, so the queue can show "this became RNL-RCT-2026-0031" and the two records
// stay joined without the request ever having been one.
//
// Amounts are integer Robux throughout, exactly as on AccountingDocument - see the note
// there for why there is no currency column.

enum PaymentRequestKind {
  /// "I want to pay you." A partner telling RNL money is coming, or has been sent -
  /// settling an invoice, paying for a booking. RNL's side of it ends in a RECEIPT.
  PAYMENT
  /// "Please pay me." A partner asking RNL for money - a payout they are expecting, an
  /// expense, work delivered. RNL's side of it ends in a CONTRACTOR_PAYMENT.
  REQUEST
  /// "Release the funds on THIS document." Raised against an already-issued payroll slip
  /// or credit note - see againstDocumentId.
  ///
  /// ---- Why this is its own kind and not a REQUEST with a column set ------
  ///
  /// Because accepting it does something completely different. Accepting a REQUEST raises
  /// a NEW draft for staff to check; accepting a RELEASE settles a document that already
  /// exists, is already numbered, and whose figures were frozen at issue. Keying that
  /// branch off "is this nullable column set" is the kind of implicit rule somebody
  /// reasonably refactors away - and the failure mode is a second payroll slip for money
  /// that was already owed once.
  ///
  /// It is deliberately absent from the two free-form pickers on pay.ronation.live for the
  /// same reason TICKET_REFUND is absent from the document builder: it has its own guarded
  /// route, where the amount comes from the document rather than from a text box. See
  /// isFreeFormRequest().
  RELEASE
}

enum PaymentRequestStatus {
  /// Submitted, nobody has looked yet. The only state the requester can create.
  OPEN
  /// Staff have accepted it and raised a document from it. See documentId.
  ACCEPTED
  /// Staff have refused it. reviewNote says why, and the requester reads that.
  DECLINED
  /// Withdrawn by the requester before anybody acted. Their own doing, so no note.
  WITHDRAWN
}

model PaymentRequest {
  id String @id @default(cuid())

  kind   PaymentRequestKind
  status PaymentRequestStatus @default(OPEN)

  /// The entity this was raised by - the scope key, and the whole authorization story for
  /// reading one back. A PLAIN column rather than an FK for the same reason
  /// AccountingDocument.partnerAccountId is one: the request is a record of something that
  /// was asked, and it must outlive any tidying up of the entity that asked it.
  partnerAccountId   String
  /// The entity's name at the time of asking, snapshotted - a rename must not rewrite what
  /// staff were looking at when they decided.
  partnerAccountName String

  /// The individual who submitted it. Snapshotted from their session, so it survives them
  /// losing their membership.
  submittedByRobloxId String
  submittedByName     String

  /// What they are asking for, in integer Robux. Positive, always - direction is `kind`,
  /// never a sign, so a negative amount cannot silently flip a payment into a payout.
  amountRobux Int

  /// One line saying what it is for. Required - a bare figure is not a request.
  reference String
  /// Anything else they want to say. Optional.
  detail    String?

  /// Their own reference for it - a Roblox transaction id, a group payout note, an
  /// invoice number of theirs. Optional, free text, and the thing staff actually match
  /// against when checking whether the money really arrived.
  externalRef String?

  /// The date the money moved or is expected to. Optional - a PAYMENT usually has one
  /// (they know when they sent it), a REQUEST usually does not.
  expectedAt DateTime?

  // ---- The company's answer ----------------------------------------------

  /// Who reviewed it, snapshotted. Null while OPEN.
  reviewedByRobloxId String?
  reviewedByName     String?
  reviewedAt         DateTime?
  /// Why it was declined, or a note on acceptance. Shown to the requester, so it is
  /// written for them to read - not an internal aside.
  reviewNote         String?

  /// The AccountingDocument raised from this, once accepted. A PLAIN column, like every
  /// other cross-reference in this schema: nothing is joined through it, and the request
  /// must survive a draft being discarded.
  ///
  /// Set on PAYMENT and REQUEST. On a RELEASE it is set to againstDocumentId at acceptance
  /// - the document it settled IS the document it produced - so "what did this become?"
  /// has one answer to read, whichever kind you are looking at.
  documentId String?

  /// The already-issued document whose funds are being claimed. Set on RELEASE, and only
  /// on RELEASE.
  ///
  /// Issuing a payroll slip or a credit note does NOT send any Robux - the amount is held
  /// until the payee asks for it, which is what this row is. Accepting one marks that
  /// document PAID; nothing new is raised.
  ///
  /// A PLAIN column, not an FK, for the reason every other cross-reference here gives: the
  /// record of somebody having asked must outlive whatever happens to the thing they asked
  /// about.
  againstDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The staff queue: open first, newest first. The default read on accounts.ronation.live.
  @@index([status, createdAt])
  /// The requester's own list on pay.ronation.live - scoped to their entity, always.
  @@index([partnerAccountId, createdAt])
  /// "Has anybody already asked for the funds on this document?" - read on every row of a
  /// client's statement, and again as the double-claim guard before a RELEASE is written.
  ///
  /// NOT a unique index, deliberately. A document may legitimately accumulate several
  /// release requests over its life: one withdrawn, one declined, one finally accepted. The
  /// rule that actually matters is "at most one OPEN at a time", which is a partial unique
  /// constraint Prisma cannot express - so it is enforced in the write path instead, in
  /// createReleaseRequest(). See the note there.
  @@index([againstDocumentId])
  @@map("payment_requests")
}

// ---- The partner programme -------------------------------------------------
//
// Everything on partner.ronation.live that happens BEFORE a PartnerAccount exists, plus
// the one thing that happens after it: the brief RNL builds a partner's site from.
//
// The whole host is one funnel, and each model below is one step of it:
//
//   /              the programme. Marketing, no rows.
//   /join/new      PartnerApplication - "we would like to work with you". They write it.
//   /invite/<uuid> PartnerInvite      - "we would like to work with YOU". RNL writes it,
//                                       and claiming one is what mints the PartnerAccount.
//   /onboard       PartnerOnboarding  - the explained-and-gathered middle. One per account.
//   /onboard/site/<uuid>
//                  PartnerSiteBrief   - everything needed to build their site, which staff
//                                       download as a .zip from /company/partnerships.
//
// ---- Applications and invites are NOT the same row with a flag --------------
//
// They point in opposite directions and they trust opposite things. An application is
// unsolicited input from a stranger: it authorises nothing, it is read by a human, and the
// worst case is spam. An invite is a BEARER CAPABILITY that RNL issued - holding the uuid
// is what lets somebody become a partner account, and the worst case is a stranger who
// did. One table with a "direction" column would put those two security stories one
// forgotten if-statement apart, so they are two tables and the join between them is
// optional.

enum PartnerApplicationStatus {
  /// Nobody has looked at it yet. The inbox's default filter.
  NEW
  /// Somebody at RNL has picked it up. Purely so two people do not both reply.
  REVIEWING
  /// Turned into an invite. inviteId points at the one it became.
  ACCEPTED
  /// Answered no. Kept rather than deleted - "did we already say no to these people?" is a
  /// question that gets asked.
  DECLINED
}

/// Somebody asking to become a partner, from partner.ronation.live/join/new.
///
/// Behind a Roblox sign-in, for exactly the reason the contact form is (see the long note
/// in app/actions/partner-applications.ts): it is a public write to the production
/// database, and a session is the cheapest wall that costs a real applicant nothing.
model PartnerApplication {
  id String @id @default(cuid())

  /// Who submitted it, snapshotted from the session like everywhere else in this schema.
  robloxId    String
  username    String
  displayName String

  /// The entity that wants to partner - the group, the label, the person.
  name String
  kind PartnerAccountKind

  /// How to reach them off Roblox. Both optional here and at-least-one required by the
  /// action - a form that demands an email address from somebody who runs a fan group
  /// entirely on Discord is a form they close.
  email   String?
  discord String?

  /// Their public Roblox group, if they run one. Diligence only; it grants nothing,
  /// exactly as the registry's own robloxGroupUrl does not.
  robloxGroupUrl String?

  /// Their words, and the two questions worth asking: what they do, and what they want.
  about String @db.Text
  want  String @db.Text

  /// Roughly how big they are. A free string on purpose - "members" means something
  /// different to a record label and to a fan group, and a number column would invite a
  /// comparison neither of them survives.
  audience String?

  /// Which parts of the programme they are asking for. PROGRAMME_OFFERS ids from
  /// lib/partner-program.ts, intersected against that list on write so a hand-posted form
  /// cannot put arbitrary strings in here.
  interests String[] @default([])

  status PartnerApplicationStatus @default(NEW)

  /// Staff's own notes. Never rendered anywhere the applicant can reach.
  note String?

  /// The invite this became, when staff accepted it. Nullable and SetNull: revoking an
  /// invite must not delete the application that earned it.
  inviteId String?        @unique
  invite   PartnerInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  /// One OPEN application per Roblox account is enforced in the action, not here - a
  /// person who was declined a year ago may reasonably ask again.
  @@index([robloxId])
  @@map("partner_applications")
}

enum PartnerInviteStatus {
  /// Issued, unclaimed, not yet expired. The only state the invite page will act on.
  PENDING
  /// Somebody signed in and claimed it. partnerAccountId is what it created.
  CLAIMED
  /// Called back before it was used. Distinct from expiry because a revoked invite is a
  /// decision and an expired one is a clock, and staff want to see which happened.
  REVOKED
}

/// An invitation to become a partner, handed out by RNL staff.
///
/// ---- code is a bearer capability, and that is the whole design ------------
///
/// partner.ronation.live/invite/<code> is sent to somebody who has no account here and may
/// never have visited. So the uuid IS the authorisation: whoever holds it can claim it,
/// once, and claiming it mints a PartnerAccount with their Roblox login attached. That is
/// the same trust model as a document share link (see AccountingDocument.shareToken), and
/// it carries the same obligations - it expires, it can be revoked, and it is spent
/// atomically so two tabs cannot both claim it.
///
/// A uuid rather than a cuid because a v4 uuid is 122 bits of randomness, which is what a
/// link that grants an account has to be.
model PartnerInvite {
  id   String @id @default(cuid())
  code String @unique @default(uuid())

  /// Who this was cut for, in staff's words - "Sleep Token RO", "Mara, booking". Printed
  /// on the invite page, so it should read as a greeting rather than a reference.
  label String

  /// What the claim should create. A PERSON invite makes a one-member entity; a COMPANY
  /// one expects more logins to be added later from /company/partner-accounts.
  kind PartnerAccountKind @default(COMPANY)

  /// Staff's own context - where they came from, what was agreed on the call.
  note String?

  status PartnerInviteStatus @default(PENDING)

  /// Invites expire. An unclaimed link that works forever is a permanent grant sitting in
  /// somebody's Discord history, and the person who issued it will not remember it exists.
  expiresAt DateTime

  issuedByRobloxId String
  issuedByName     String

  /// Filled at the moment of claim, snapshotted from the session.
  claimedAt         DateTime?
  claimedByRobloxId String?
  claimedByName     String?

  /// The entity the claim created. Nullable because it does not exist until then, and
  /// SetNull rather than Cascade: deleting a partner account should not erase the record
  /// that RNL invited them.
  partnerAccountId String?
  partnerAccount   PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: SetNull)

  /// The application this invite answers, if it answers one.
  application PartnerApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([partnerAccountId])
  @@map("partner_invites")
}

/// A partner's progress through partner.ronation.live/onboard, and what it gathered.
///
/// One row per PartnerAccount, created the first time they open the flow. step is the
/// FURTHEST step they have reached, not the one they are on - so a partner who goes back
/// to re-read the features step does not lose the details they already typed, and /onboard
/// can send a returning visitor straight to where they stopped.
model PartnerOnboarding {
  id String @id @default(cuid())

  partnerAccountId String         @unique
  partnerAccount   PartnerAccount @relation(fields: [partnerAccountId], references: [id], onDelete: Cascade)

  /// An index into ONBOARDING_STEPS (lib/partner-onboarding.ts). Clamped to that array's
  /// bounds on every write, so a shorter list after a deploy cannot strand anybody past
  /// the end of it.
  step Int @default(0)

  /// Set when they finish the last step. Null means in progress, and the hub says so.
  completedAt DateTime?

  // ---- What the flow gathers ----------------------------------------------
  //
  // Deliberately small. Everything here is something RNL would otherwise ask for in a
  // Discord thread and then lose; nothing here is anything RNL could look up for itself.

  contactName    String?
  contactEmail   String?
  contactDiscord String?
  robloxGroupUrl String?

  /// What they run, in their own words. Seeds the site brief's description later.
  about String? @db.Text

  /// Which parts of the programme they want switched on. PROGRAMME_OFFERS ids, intersected
  /// on write - the same list the application form offers.
  interests String[] @default([])

  /// The timezone they schedule shows in, so booking a slot is not three messages of
  /// "what time is that for you". A free string: an IANA name when the browser offers one.
  timezone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_onboardings")
}

enum PartnerSiteBriefStatus {
  /// Being filled in. Saves on every step, so a half-finished brief survives a closed tab.
  DRAFT
  /// Handed in. Still editable by the holder - a brief is a description, not a contract -
  /// but staff now have something worth downloading.
  SUBMITTED
}

/// Everything needed to build a partner their own site, gathered from the partner.
///
/// The fields below are not invented: they are, near enough one for one, the Partner type
/// in lib/partners/registry.ts - the config-in-code that themes and routes a partner site.
/// That is deliberate. A brief whose shape matches the thing it becomes can be read
/// straight down when somebody writes the registry entry, and the .zip emits exactly that
/// entry as a starting point (lib/partner-brief.ts).
///
/// Reached at partner.ronation.live/onboard/site/<token>, and token is a bearer capability
/// for the same reason PartnerInvite.code is: the person who knows the brand - their
/// designer, their manager - very often is not one of the Roblox logins on the account,
/// and RNL would rather have the real answers than the reachable ones.
model PartnerSiteBrief {
  id    String @id @default(cuid())
  token String @unique @default(uuid())

  /// The account this is for, when there is one. Nullable because RNL raises briefs for
  /// people who are still partway through being onboarded.
  partnerAccountId String?
  partnerAccount   PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: SetNull)

  /// What staff called it when they raised it. The one field the partner does not write.
  label String

  status PartnerSiteBriefStatus @default(DRAFT)

  // ---- The registry entry, as answered by the partner ----------------------

  /// The subdomain they want: <slug>.ronation.live. Validated against the same shape and
  /// the same reserved list the registry enforces, at write time, so a brief cannot ask
  /// for "login" and have nobody notice until deploy day.
  slug String?

  siteName    String?
  shortName   String?
  tagline     String?
  description String? @db.Text

  /// The small print for a partner running tribute or fan events for a real-world act.
  /// See the note on Partner.disclaimer - a site on an RNL subdomain with an ambiguous one
  /// is RNL's problem as much as theirs.
  disclaimer String? @db.Text

  /// Ticket codes read <PREFIX>-XXXXXX.
  ticketPrefix String?

  robloxGroupUrl String?

  /// Which shared features they want: PartnerFeature values (events, blog, careers,
  /// surveys), intersected against that list on write.
  features String[] @default([])

  // ---- Look ---------------------------------------------------------------

  /// The one colour the whole site is built around, as #rrggbb. Validated on write, and
  /// stored as typed rather than normalised - a partner's brand hex is a string their
  /// designer recognises on sight.
  accentColour String?

  /// The colour of type ON the accent - the other half of a readable button. Same shape.
  accentInkColour String?

  /// Which of the shipped display faces they want. A FONT_CHOICES key, intersected on
  /// write; "something else" is a sentence in moodNotes, not a font RNL does not have.
  fontChoice String?

  /// Anything the fields above cannot hold. This is where the useful stuff ends up.
  moodNotes String? @db.Text

  /// Sites, socials or artwork they want it to feel like. Trimmed and capped on write.
  referenceUrls String[] @default([])

  // ---- Who to ask ---------------------------------------------------------

  contactName    String?
  contactEmail   String?
  contactDiscord String?

  assets PartnerSiteBriefAsset[]

  issuedByRobloxId String
  issuedByName     String

  /// When they handed it in. Set once, on the first submit - a later edit does not move
  /// it, because "when did we get this" is a different question from "when did they last
  /// touch it".
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([partnerAccountId])
  @@map("partner_site_briefs")
}

enum PartnerBriefAssetSlot {
  /// The wordmark on a ticket's issuer bar. White or very light, transparent background -
  /// see Partner.logoUrl for why that bar eats a dark logo.
  LOGO
  /// The big dim emblem the homepage hero is built around. Partner.crestUrl.
  CREST
  /// Artwork behind the whole site. Partner.backdropUrl.
  BACKDROP
  /// The stand-in image for a show with no poster yet. Partner.eventPlaceholderUrl.
  EVENT_PLACEHOLDER
  /// Anything else they wanted RNL to have.
  OTHER
}

/// A file a partner attached to their brief.
///
/// On the PRIVATE upload volume, and that is not a detail. These are unreleased brand
/// assets uploaded by somebody who is not yet a partner - a logo nobody has announced, a
/// poster for a show with no date. Caddy serves /uploads straight off its own volume
/// before Next ever sees the request, so anything stored there is world-readable by
/// design; there is no session in front of it and there cannot be. See lib/uploads.ts.
///
/// The only reader is the .zip route under /company/partnerships, which checks company rank.
model PartnerSiteBriefAsset {
  id String @id @default(cuid())

  briefId String
  brief   PartnerSiteBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  slot PartnerBriefAssetSlot

  /// The path INSIDE PRIVATE_UPLOAD_DIR. Never a URL, because nothing serves these at a
  /// URL. Resolved with resolveInRoot() before it is ever opened.
  storagePath String
  filename    String
  /// Sniffed from the bytes at upload - never the string the browser claimed.
  mime        String
  size        Int

  /// Snapshotted from whoever's session posted it, or "brief link" when it came in on the
  /// token alone - which is the normal case, since the holder need not have an account.
  uploadedBy String

  createdAt DateTime @default(now())

  @@index([briefId, slot])
  @@map("partner_site_brief_assets")
}
